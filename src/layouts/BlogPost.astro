---
// Single blog post page. The language switcher links to the other
// language's blog index, since posts are not paired one to one.
import { render, type CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import { profile, translations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  post: CollectionEntry<'blog'>;
}

const { lang, post } = Astro.props;
const t = translations[lang];
const { Content } = await render(post);

const slug = post.id.split('/').slice(1).join('/');
const paths: Record<Lang, string> = {
  es: lang === 'es' ? `blog/${slug}/` : 'blog/',
  en: lang === 'en' ? `en/blog/${slug}/` : 'en/blog/',
};

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const blogIndex = `${base}${lang === 'en' ? 'en/' : ''}blog/`;

const locale = lang === 'es' ? 'es-CO' : 'en-US';
const dateFormat: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'long', day: 'numeric' };
---

<Base
  lang={lang}
  title={`${post.data.title} — ${profile.name}`}
  description={post.data.description}
  paths={paths}
  hreflangAlternates={false}
>
  <article class="post">
    <a class="back-link" href={blogIndex}>← {t.blog.back}</a>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString(locale, dateFormat)}
        </time>
        {
          post.data.tags.length > 0 && (
            <ul class="chips chips-small">
              {post.data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
