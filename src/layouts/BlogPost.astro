---
// Single blog post page. The language switcher links to the other
// language's blog index, since posts are not paired one to one.
import { render, type CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import { profile, translations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  post: CollectionEntry<'blog'>;
}

const { lang, post } = Astro.props;
const t = translations[lang];
const { Content } = await render(post);

// Slugs translation dictionary between languages
const translationPairs: Record<string, string> = {
  'la-ia-no-piensa-guia-arquitectura-y-checklist': 'ai-does-not-think-architecture-guide-and-checklist',
  'ai-does-not-think-architecture-guide-and-checklist': 'la-ia-no-piensa-guia-arquitectura-y-checklist',
  '1000-seguidores-en-instagram': '1000-instagram-followers',
  '1000-instagram-followers': '1000-seguidores-en-instagram',
  'indices-write-amplification-costo-oculto-escrituras': 'indexes-write-amplification-hidden-cost',
  'indexes-write-amplification-hidden-cost': 'indices-write-amplification-costo-oculto-escrituras',
  'backpressure-colas-sin-limite-frenos': 'backpressure-unbounded-queues-brakes',
  'backpressure-unbounded-queues-brakes': 'backpressure-colas-sin-limite-frenos',
  'thundering-herd-cache-stampede-single-flight': 'thundering-herd-cache-stampede-single-flight',
  'hola-mundo': 'hello-world',
  'hello-world': 'hola-mundo',
};

const slug = post.id.split('/').slice(1).join('/');
const pairedSlug = translationPairs[slug];

const paths: Record<Lang, string> = {
  es: lang === 'es' ? `blog/${slug}/` : pairedSlug ? `blog/${pairedSlug}/` : 'blog/',
  en: lang === 'en' ? `en/blog/${slug}/` : pairedSlug ? `en/blog/${pairedSlug}/` : 'en/blog/',
};

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const blogIndex = `${base}${lang === 'en' ? 'en/' : ''}blog/`;

const locale = lang === 'es' ? 'es-CO' : 'en-US';
const dateFormat: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'long', day: 'numeric' };
---

<Base
  lang={lang}
  title={`${post.data.title} — ${profile.name}`}
  description={post.data.description}
  paths={paths}
  hreflangAlternates={Boolean(pairedSlug)}
>
  <article class="post">
    <a class="back-link reveal" href={blogIndex}>← {t.blog.back}</a>
    <header class="post-header" id="post-header-hero">
      <!-- Ambient Morphing Glow Blobs -->
      <div class="hero-glow hero-glow-1" aria-hidden="true"></div>
      <div class="hero-glow hero-glow-2" aria-hidden="true"></div>

      <!-- Cluster Topology Network Mesh (Canvas 2D) -->
      <div class="cluster-mesh-container" aria-hidden="true">
        <canvas id="post-cluster-mesh"></canvas>
      </div>

      <div class="docket-stamp reveal">
        {lang === 'es' ? 'REGISTRO DE ARQUITECTURA // ARTÍCULO' : 'ARCHITECTURE RECORD // ARTICLE'}
      </div>
      <h1 class="reveal" style="--delay: 60ms">{post.data.title}</h1>
      <div class="post-meta reveal" style="--delay: 120ms">
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString(locale, dateFormat)}
        </time>
        {
          post.data.tags.length > 0 && (
            <ul class="chips chips-small">
              {post.data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>

  <script is:inline>
    // Cluster Topology Network Mesh for Post Header
    (function initPostClusterMesh() {
      const canvas = document.getElementById('post-cluster-mesh');
      const header = document.getElementById('post-header-hero');
      if (!canvas || !header) return;

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      let width = 0;
      let height = 0;
      let dpr = 1;
      let animFrameId = null;
      let isVisible = true;

      const mouse = { x: -9999, y: -9999, active: false };
      let nodes = [];

      function resize() {
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        width = header.clientWidth;
        height = header.clientHeight;
        canvas.width = width * dpr;
        canvas.height = height * dpr;
        canvas.style.width = width + 'px';
        canvas.style.height = height + 'px';
        ctx.scale(dpr, dpr);
        initNodes();
      }

      function initNodes() {
        const nodeCount = Math.min(32, Math.max(14, Math.floor((width * height) / 16000)));
        nodes = [];
        for (let i = 0; i < nodeCount; i++) {
          nodes.push({
            x: Math.random() * width,
            y: Math.random() * height,
            vx: (Math.random() - 0.5) * 0.45,
            vy: (Math.random() - 0.5) * 0.45,
            radius: Math.random() * 1.5 + 1.2,
            pulse: Math.random() * Math.PI * 2,
            pulseSpeed: 0.025 + Math.random() * 0.025,
            isTelemetryBeacon: i % 5 === 0,
          });
        }
      }

      function draw() {
        if (!isVisible) return;
        ctx.clearRect(0, 0, width, height);

        const isLight = document.documentElement.classList.contains('light');
        const maxDist = 115;
        const maxDistSq = maxDist * maxDist;

        // Connections between nodes
        for (let i = 0; i < nodes.length; i++) {
          const a = nodes[i];
          for (let j = i + 1; j < nodes.length; j++) {
            const b = nodes[j];
            const dx = a.x - b.x;
            const dy = a.y - b.y;
            const distSq = dx * dx + dy * dy;

            if (distSq < maxDistSq) {
              const dist = Math.sqrt(distSq);
              const alpha = (1 - dist / maxDist) * (isLight ? 0.22 : 0.28);
              ctx.beginPath();
              ctx.moveTo(a.x, a.y);
              ctx.lineTo(b.x, b.y);
              ctx.strokeStyle = isLight
                ? `rgba(217, 119, 6, ${alpha})`
                : `rgba(245, 158, 11, ${alpha})`;
              ctx.lineWidth = 1;
              ctx.stroke();
            }
          }

          // Interactive cursor connection
          if (mouse.active) {
            const mdx = a.x - mouse.x;
            const mdy = a.y - mouse.y;
            const mDistSq = mdx * mdx + mdy * mdy;
            const mMax = 135;
            if (mDistSq < mMax * mMax) {
              const mDist = Math.sqrt(mDistSq);
              const mAlpha = (1 - mDist / mMax) * 0.45;
              ctx.beginPath();
              ctx.moveTo(a.x, a.y);
              ctx.lineTo(mouse.x, mouse.y);
              ctx.strokeStyle = isLight
                ? `rgba(217, 119, 6, ${mAlpha})`
                : `rgba(251, 191, 36, ${mAlpha})`;
              ctx.lineWidth = 1;
              ctx.stroke();
            }
          }
        }

        // Nodes rendering
        for (let i = 0; i < nodes.length; i++) {
          const n = nodes[i];
          n.x += n.vx;
          n.y += n.vy;
          n.pulse += n.pulseSpeed;

          if (n.x < 0 || n.x > width) n.vx *= -1;
          if (n.y < 0 || n.y > height) n.vy *= -1;

          const currentRadius = n.radius + Math.sin(n.pulse) * 0.4;
          ctx.beginPath();
          ctx.arc(n.x, n.y, Math.max(0.8, currentRadius), 0, Math.PI * 2);

          if (n.isTelemetryBeacon) {
            ctx.fillStyle = isLight ? '#d97706' : '#fbbf24';
            ctx.shadowColor = isLight ? 'rgba(217, 119, 6, 0.3)' : 'rgba(245, 158, 11, 0.6)';
            ctx.shadowBlur = 6;
          } else {
            ctx.fillStyle = isLight ? 'rgba(180, 83, 9, 0.7)' : 'rgba(245, 158, 11, 0.75)';
            ctx.shadowBlur = 0;
          }

          ctx.fill();
        }

        animFrameId = requestAnimationFrame(draw);
      }

      // Stop loop when header is off-screen
      if ('IntersectionObserver' in window && header) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              isVisible = entry.isIntersecting;
              if (isVisible && !animFrameId) {
                animFrameId = requestAnimationFrame(draw);
              } else if (!isVisible && animFrameId) {
                cancelAnimationFrame(animFrameId);
                animFrameId = null;
              }
            });
          },
          { threshold: 0.05 }
        );
        observer.observe(header);
      }

      if (header && window.matchMedia('(hover: hover)').matches) {
        header.addEventListener('mousemove', (e) => {
          const rect = header.getBoundingClientRect();
          mouse.x = e.clientX - rect.left;
          mouse.y = e.clientY - rect.top;
          mouse.active = true;
        });
        header.addEventListener('mouseleave', () => {
          mouse.active = false;
        });
      }

      resize();
      window.addEventListener('resize', resize);
      animFrameId = requestAnimationFrame(draw);
    })();
  </script>
</Base>
