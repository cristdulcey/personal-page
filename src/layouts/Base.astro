---
// Shared page shell: head metadata, navigation with the language
// switcher, footer and the reveal-on-scroll script. Every page renders
// its content into the default slot.
import { profile, translations, type Lang } from '../i18n';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /**
   * Path of this page in each language, relative to the site base
   * (e.g. { es: '', en: 'en/' } or { es: 'blog/', en: 'en/blog/' }).
   * The language switcher links to these paths.
   */
  paths: Record<Lang, string>;
  /**
   * Whether the two paths are real translations of the same page. When
   * false (e.g. a blog post without a translated counterpart) hreflang
   * alternates are omitted and only the canonical link is emitted.
   */
  hreflangAlternates?: boolean;
}

const { lang, title, description, paths, hreflangAlternates = true } = Astro.props;
const t = translations[lang];

// Cloudflare Web Analytics: paste the site token here (the `token` value
// inside the snippet Cloudflare shows when registering the site) and the
// beacon loads on every page. Leave empty to disable analytics.
const CF_ANALYTICS_TOKEN = '';

// Site base path with a guaranteed trailing slash
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const urls: Record<Lang, string> = { es: `${base}${paths.es}`, en: `${base}${paths.en}` };
const home = lang === 'en' ? `${base}en/` : base;
const site = Astro.site ?? 'https://cristdulcey.com';
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Chivo:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="canonical" href={new URL(urls[lang], site)} />
    {
      hreflangAlternates && (
        <>
          <link rel="alternate" hreflang="es" href={new URL(urls.es, site)} />
          <link rel="alternate" hreflang="en" href={new URL(urls.en, site)} />
          <link rel="alternate" hreflang="x-default" href={new URL(urls.es, site)} />
        </>
      )
    }
    <title>{title}</title>
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: light)').matches) {
          return 'light';
        }
        return 'dark';
      })();
      if (theme === 'light') {
        document.documentElement.classList.add('light');
      } else {
        document.documentElement.classList.remove('light');
      }
    </script>
    {
      CF_ANALYTICS_TOKEN && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${CF_ANALYTICS_TOKEN}"}`}
        />
      )
    }
  </head>
  <body>
    <!-- Mission Telemetry Status Bar -->
    <div class="mission-bar">
      <div class="mission-indicator">
        <span class="status-dot"></span>
        <span>MISSION ARCHITECTURE // PROD ENVELOPE</span>
      </div>
      <div class="mission-coords">
        <span>LATAM / GLOBAL INFRASTRUCTURE</span>
        <span class="mission-sep">·</span>
        <span class="mission-sla">SLA 99.999%</span>
      </div>
    </div>

    <header class="nav">
      <nav>
        <a class="logo" href={home}>CD<span class="dot">.</span></a>
        <ul>
          <li><a href={`${home}#work`}>{t.nav.work}</a></li>
          <li><a href={`${home}#projects`}>{t.nav.projects}</a></li>
          <li><a href={`${home}#content`}>{t.nav.content}</a></li>
          <li><a href={`${home}blog/`}>{t.nav.blog}</a></li>
          <li><a href={`${home}#contact`}>{t.nav.contact}</a></li>
        </ul>
        <div class="nav-actions">
          <div class="lang-switch" aria-label={t.nav.langLabel}>
            <a href={urls.es} class={lang === 'es' ? 'active' : ''} aria-current={lang === 'es' ? 'page' : undefined}>ES</a>
            <a href={urls.en} class={lang === 'en' ? 'active' : ''} aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
          </div>
          <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Cambiar tema claro / oscuro" title="Modo Claro / Oscuro">
            <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>
            <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
          </button>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <ul class="socials socials-footer" aria-label={t.hero.socialsLabel}>
        {
          profile.socials.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener" title={s.name} aria-label={s.name}>
                <img src={`${base}icons/${s.icon}.svg`} alt="" width="18" height="18" loading="lazy" />
              </a>
            </li>
          ))
        }
      </ul>
      <p>© {new Date().getFullYear()} {profile.name} · {t.footer}</p>
    </footer>

    <script>
      // Reveal-on-scroll animation. Animates once upon entry to eliminate jitter and animation fatigue.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -30px' }
      );
      document
        .querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-zoom')
        .forEach((el) => observer.observe(el));

      // Dark / Light Mode Switcher
      const toggle = document.getElementById('theme-toggle');
      if (toggle) {
        toggle.addEventListener('click', () => {
          const isLight = document.documentElement.classList.toggle('light');
          localStorage.setItem('theme', isLight ? 'light' : 'dark');
        });
      }
    </script>
  </body>
</html>
