---
// Home page content, shared by every language. All copy comes from
// src/i18n.ts; the `lang` prop selects which translation to render.
import Base from './Base.astro';
import { profile, projectMedia, translations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];

// Site base path with a guaranteed trailing slash
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const photoUrl = `${base}${profile.photo}`;
---

<Base
  lang={lang}
  title={`${profile.name} — ${t.hero.role}`}
  description={t.meta.description}
  paths={{ es: '', en: 'en/' }}
>
  <section id="home" class="hero">
    <div class="hero-text">
      <p class="hero-kicker reveal">{t.hero.kicker}</p>
      <h1 class="reveal" style="--delay: 80ms">{profile.name}</h1>
      <p class="hero-role reveal" style="--delay: 160ms">
        <span class="gradient-text">{t.hero.role}</span>
      </p>
      <p class="hero-desc reveal" style="--delay: 240ms">{t.hero.description}</p>
      <div class="hero-cta reveal" style="--delay: 320ms">
        <a class="btn btn-primary" href="#work">{t.hero.ctaWork}</a>
        <a class="btn btn-ghost" href="#contact">{t.hero.ctaContact}</a>
      </div>
      <ul class="socials reveal" style="--delay: 400ms" aria-label={t.hero.socialsLabel}>
        {
          profile.socials.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener" title={s.name} aria-label={s.name}>
                <img src={`${base}icons/${s.icon}.svg`} alt="" width="22" height="22" loading="lazy" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="hero-photo reveal" style="--delay: 200ms">
      <img src={photoUrl} alt={t.hero.photoAlt} width="320" height="320" />
    </div>
  </section>

  <section id="work" class="section">
    <h2 class="reveal"><span class="section-num">01</span> {t.work.title}</h2>
    <p class="section-intro reveal">{t.work.intro}</p>
    <ol class="areas">
      {
        t.work.areas.map((a, i) => (
          <li class="area reveal" style={`--delay: ${i * 80}ms`}>
            <span class="area-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="area-title">{a.title}</h3>
            <p class="area-desc">{a.desc}</p>
            <span class="area-icon" aria-hidden="true">{a.icon}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="projects" class="section">
    <h2 class="reveal"><span class="section-num">02</span> {t.projects.title}</h2>
    <p class="section-intro reveal">{t.projects.intro}</p>
    <div class="cards-scroll">
      {
        t.projects.items.map((p, i) => {
          const media = projectMedia[p.key];
          return (
            <a
              class="card project-card reveal"
              href={p.url}
              target="_blank"
              rel="noopener"
              style={`--delay: ${i * 90}ms`}
            >
              {media.image ? (
                <figure class="card-media">
                  <img src={`${base}${media.image}`} alt="" loading="lazy" />
                </figure>
              ) : (
                <figure
                  class="card-media card-banner"
                  style={`--banner-from: ${media.from}; --banner-to: ${media.to}`}
                >
                  <span class="banner-emblem" aria-hidden="true">{media.emblem}</span>
                  <span class="banner-initial" aria-hidden="true">{p.title.charAt(0)}</span>
                </figure>
              )}
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
              <ul class="chips chips-small">
                {p.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            </a>
          );
        })
      }
    </div>
  </section>

  <section id="content" class="section">
    <h2 class="reveal"><span class="section-num">03</span> {t.content.title}</h2>
    <p class="section-intro reveal">{t.content.intro}</p>
    <div class="cards">
      {
        t.content.cards.map((c, i) => (
          <a
            class="card content-card reveal"
            href={profile.contentLinks[c.linkKey]}
            target="_blank"
            rel="noopener"
            style={`--delay: ${i * 90}ms; --glow: ${c.glow}`}
          >
            <span class="content-icon">
              <img src={`${base}icons/${c.icon}.svg`} alt="" width="26" height="26" loading="lazy" />
            </span>
            <h3>{c.name}</h3>
            <p>{c.desc}</p>
            <span class="card-action">{c.action} →</span>
          </a>
        ))
      }
    </div>
  </section>

  <section id="about" class="section">
    <h2 class="reveal"><span class="section-num">04</span> {t.about.title}</h2>
    <div class="about-grid">
      <div class="reveal">
        <p>{t.about.p1}</p>
        <p>{t.about.p2}</p>
      </div>
      <div class="reveal" style="--delay: 120ms">
        <h3>{t.about.skillsTitle}</h3>
        <ul class="chips">
          {t.about.skills.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="contact" class="section contact">
    <h2 class="reveal"><span class="section-num">05</span> {t.contact.title}</h2>
    <p class="reveal">{t.contact.lead}</p>
    <div class="hero-cta reveal" style="--delay: 100ms">
      <a class="btn btn-primary btn-icon" href={`mailto:${profile.email}`}>
        <img src={`${base}icons/generic-email.svg`} alt="" width="18" height="18" />
        {t.contact.emailButton}
      </a>
      {
        profile.socials.slice(0, 2).map((s) => (
          <a class="btn btn-ghost btn-icon" href={s.url} target="_blank" rel="noopener">
            <img src={`${base}icons/${s.icon}.svg`} alt="" width="18" height="18" />
            {s.name}
          </a>
        ))
      }
    </div>
    <div class="support reveal" style="--delay: 200ms">
      <p>{t.contact.supportLead}</p>
      <div class="hero-cta">
        <a class="btn btn-ghost btn-icon" href={profile.supportLinks.coffee} target="_blank" rel="noopener">
          <img src={`${base}icons/buy-me-a-coffee.svg`} alt="" width="18" height="18" />
          {t.contact.coffee}
        </a>
        <a class="btn btn-ghost btn-icon" href={profile.supportLinks.paypal} target="_blank" rel="noopener">
          <img src={`${base}icons/paypal.svg`} alt="" width="18" height="18" />
          {t.contact.paypal}
        </a>
      </div>
    </div>
  </section>
</Base>
