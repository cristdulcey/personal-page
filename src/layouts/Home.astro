---
// Home page content, shared by every language. All copy comes from
// src/i18n.ts; the `lang` prop selects which translation to render.
import Base from './Base.astro';
import TelemetryConsole from '../components/TelemetryConsole.astro';
import { profile, projectMedia, translations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];

// Site base path with a guaranteed trailing slash
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const photoUrl = `${base}${profile.photo}`;
const blogUrl = `${base}${lang === 'en' ? 'en/' : ''}blog/`;

const isEs = lang === 'es';
---

<Base
  lang={lang}
  title={`${profile.name} — ${t.hero.role}`}
  description={t.meta.description}
  paths={{ es: '', en: 'en/' }}
>
  <!-- Hero Section -->
  <section id="home" class="hero">
    <!-- Ambient Morphing Glow Blobs -->
    <div class="hero-glow hero-glow-1" aria-hidden="true"></div>
    <div class="hero-glow hero-glow-2" aria-hidden="true"></div>

    <!-- Cluster Topology Network Mesh (Canvas 2D) -->
    <div class="cluster-mesh-container" aria-hidden="true">
      <canvas id="cluster-mesh"></canvas>
    </div>

    <div class="hero-text">
      <div class="docket-stamp reveal">{isEs ? 'DOSSIER ARQUITECTÓNICO // CRISTIAN DULCEY' : 'ARCHITECTURAL DOSSIER // CRISTIAN DULCEY'}</div>
      <h1 class="reveal" style="--delay: 80ms">
        {isEs ? 'Arquitectura de Sistemas de ' : 'High-Reliability Architecture for '}
        <span class="amber-text">{isEs ? 'Misión Crítica' : 'Sovereign Scale'}</span>.
      </h1>
      <p class="hero-role reveal" style="--delay: 140ms">
        <strong>{profile.name}</strong>
        <span style="color: var(--text-dim); font-weight: 500;"> · {t.hero.role}</span>
      </p>
      <p class="hero-desc reveal" style="--delay: 200ms">{t.hero.description}</p>
      
      <div class="hero-cta reveal" style="--delay: 260ms">
        <a class="btn btn-primary" href="#projects">{t.hero.ctaWork} →</a>
        <a class="btn btn-ghost" href="#contact">{t.hero.ctaContact}</a>
      </div>

      <!-- Specification Strip -->
      <div class="spec-grid reveal" style="--delay: 340ms">
        <div class="spec-box">
          <span class="spec-label">{isEs ? 'Escala Soberana' : 'Sovereign Scale'}</span>
          <div class="spec-value">4M+</div>
          <div class="spec-sub">{isEs ? 'Usuarios en Chivo Wallet' : 'Citizens on Chivo Wallet'}</div>
        </div>
        <div class="spec-box">
          <span class="spec-label">{isEs ? 'Clúster Distribuido' : 'Distributed Cluster'}</span>
          <div class="spec-value">300+</div>
          <div class="spec-sub">{isEs ? 'Microservicios en Azure K8s' : 'Microservices on Azure K8s'}</div>
        </div>
        <div class="spec-box">
          <span class="spec-label">{isEs ? 'Pico de Throughput' : 'Throughput Peak'}</span>
          <div class="spec-value">100K+</div>
          <div class="spec-sub">{isEs ? 'Req/seg en concurrencia' : 'Peak req/s concurrency'}</div>
        </div>
        <div class="spec-box">
          <span class="spec-label">{isEs ? 'Trayectoria Técnica' : 'Production Tenure'}</span>
          <div class="spec-value">15+</div>
          <div class="spec-sub">{isEs ? 'Años en arquitectura' : 'Years in architecture'}</div>
        </div>
      </div>
    </div>

    <!-- Right Column: Prominent Portrait + Telemetry Console -->
    <div class="hero-interactive reveal-zoom" style="--delay: 200ms">
      <div class="architect-portrait-hero tilt-card">
        <div class="portrait-frame">
          <img src={photoUrl} alt={t.hero.photoAlt} class="portrait-img" loading="eager" />
        </div>
        <div class="portrait-meta">
          <div class="portrait-name-row">
            <span class="portrait-name">{profile.name}</span>
            <span class="portrait-badge">GDE · MVP</span>
          </div>
          <span class="portrait-title">Lead Systems Architect</span>
          <span class="portrait-location">{isEs ? 'Villavicencio, CO · Infraestructura Soberana' : 'Villavicencio, CO · Sovereign Infrastructure'}</span>
        </div>
      </div>

      <TelemetryConsole lang={lang} />
    </div>
  </section>

  <!-- Projects / Flagship Dossiers Section -->
  <section id="projects" class="section">
    <div style="margin-bottom: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem; display: flex; justify-content: space-between; align-items: baseline;">
      <h2 class="reveal" style="margin: 0; font-size: 1.85rem; font-weight: 800;">
        <span class="celeste-text" style="font-family: var(--font-mono); font-size: 0.85em; margin-right: 0.5rem;">01 //</span>
        {isEs ? 'Sistemas de Misión Crítica & Casos de Estudio' : 'Mission-Critical Systems & Case Studies'}
      </h2>
      <span style="font-family: var(--font-mono); font-size: 0.76rem; color: var(--text-dim); text-transform: uppercase;">{isEs ? 'PRODUCCIÓN VERIFICADA' : 'VERIFIED PRODUCTION'}</span>
    </div>

    <!-- Dossier 01: Chivo Wallet -->
    <article class="dossier-card tilt-card reveal-left">
      <div class="dossier-header">
        <div>
          <div class="dossier-code">{isEs ? 'DOSSIER #001 // LEDGER DE CURSO LEGAL NACIONAL' : 'DOSSIER #001 // NATIONAL LEGAL TENDER LEDGER'}</div>
          <h3 class="dossier-name">Chivo Wallet — Core Banking & Ledger</h3>
        </div>
        <div class="dossier-tags">
          <span class="dossier-tag">Bitcoin Core</span>
          <span class="dossier-tag">Idempotent Settlement</span>
          <span class="dossier-tag">Fintech Sovereign</span>
          <span class="dossier-tag">{isEs ? '4M+ Usuarios' : '4M+ Users'}</span>
        </div>
      </div>
      <div class="dossier-body">
        <div class="dossier-text">
          <p>
            {isEs 
              ? 'Diseño e implementación de la arquitectura del backend de atención al cliente y liquidación bancaria para el ecosistema de moneda de curso legal de El Salvador.'
              : 'Architecture and engineering leadership for customer support backend and banking settlement systems for the sovereign Bitcoin legal tender ecosystem in El Salvador.'}
          </p>
          <p>
            {isEs
              ? 'Garantía de idempotencia transaccional y reconciliación en tiempo real entre Bitcoin Lightning Network y el sistema bancario nacional, procesando millones de transferencias con trazabilidad auditable absoluta.'
              : 'Enforced strict transactional idempotency and real-time reconciliation between Bitcoin Lightning Network and domestic fiat banking clearing, processing millions of transfers with zero loss.'}
          </p>
          <a class="dossier-action" href={`${base}${isEs ? '' : 'en/'}projects/chivo/`}>
            {t.projects.caseStudyAction} →
          </a>
        </div>
        <div class="dossier-specs-box">
          <div class="spec-line"><span class="spec-k">{isEs ? 'Alcance:' : 'Scale:'}</span> <span class="spec-v">4,000,000+ {isEs ? 'ciudadanos' : 'citizens'}</span></div>
          <div class="spec-line"><span class="spec-k">{isEs ? 'Rol:' : 'Role:'}</span> <span class="spec-v">Backend Systems Lead</span></div>
          <div class="spec-line"><span class="spec-k">{isEs ? 'SLA Transaccional:' : 'SLA Guarantee:'}</span> <span class="spec-v">Zero Loss / Idempotent</span></div>
          <div class="spec-line"><span class="spec-k">{isEs ? 'Liquidación:' : 'Settlement:'}</span> <span class="spec-v">Lightning & Fiat Clearing</span></div>
        </div>
      </div>
    </article>

    <!-- Dossier 02: Proyecto Fénix -->
    <article class="dossier-card tilt-card reveal-right" style="--delay: 100ms">
      <div class="dossier-header">
        <div>
          <div class="dossier-code">{isEs ? 'DOSSIER #002 // MALLA DE RESILIENCIA CLOUD-NATIVE' : 'DOSSIER #002 // CLOUD-NATIVE RESILIENCE MESH'}</div>
          <h3 class="dossier-name">Proyecto Fénix — Malla Empresarial AKS</h3>
        </div>
        <div class="dossier-tags">
          <span class="dossier-tag">Azure Kubernetes</span>
          <span class="dossier-tag">Terraform IaC</span>
          <span class="dossier-tag">300+ Microservicios</span>
          <span class="dossier-tag">100K+ req/s</span>
        </div>
      </div>
      <div class="dossier-body">
        <div class="dossier-text">
          <p>
            {isEs
              ? 'Reestructuración arquitectónica y orquestación de más de 300 microservicios sobre Azure Kubernetes Service (AKS) para la Secretaría de Movilidad de Bogotá.'
              : 'Architectural restructuring and orchestration of 300+ microservices on Azure Kubernetes Service (AKS) for the Bogota Mobility Secretariat.'}
          </p>
          <p>
            {isEs
              ? 'Implementación de módulos declarativos de Terraform, pipelines de despliegue continuo con zero-downtime y auto-escalado horizontal predictivo capaz de sostener picos masivos de demanda corporativa.'
              : 'Implemented 100% declarative Terraform modules, zero-downtime CI/CD pipelines in Azure DevOps, and predictive horizontal autoscaling sustaining extreme municipal peak concurrency.'}
          </p>
          <a class="dossier-action" href={`${base}${isEs ? '' : 'en/'}projects/fenix/`}>
            {t.projects.caseStudyAction} →
          </a>
        </div>
        <div class="dossier-specs-box">
          <div class="spec-line"><span class="spec-k">{isEs ? 'Topología:' : 'Topology:'}</span> <span class="spec-v">Multi-Región AKS Mesh</span></div>
          <div class="spec-line"><span class="spec-k">{isEs ? 'Concurrencia:' : 'Concurrency:'}</span> <span class="spec-v">100,000+ req/s</span></div>
          <div class="spec-line"><span class="spec-k">{isEs ? 'Disponibilidad:' : 'Availability:'}</span> <span class="spec-v">99.99% Enterprise SLA</span></div>
          <div class="spec-line"><span class="spec-k">{isEs ? 'Automatización:' : 'Automation:'}</span> <span class="spec-v">Terraform IaC (100%)</span></div>
        </div>
      </div>
    </article>

    <!-- Secondary Projects (WalletGuru, Mad Droids) -->
    <div class="projects-grid" style="margin-top: 2rem;">
      {
        t.projects.items.slice(2).map((p, i) => {
          const media = projectMedia[p.key];
          return (
            <a
              class="card project-card reveal-zoom"
              href={p.url}
              target="_blank"
              rel="noopener"
              style={`--delay: ${i * 90}ms`}
            >
              <figure
                class="card-media card-banner"
                style={`--banner-from: ${media.from}; --banner-to: ${media.to}`}
              >
                <span class="banner-emblem" aria-hidden="true">{media.emblem}</span>
                <span class="banner-initial" aria-hidden="true">{p.title.charAt(0)}</span>
              </figure>
              <div class="project-body">
                <h3>{p.title}</h3>
                <p>{p.desc}</p>
                <ul class="chips chips-small">
                  {p.tags.map((tag) => <li>{tag}</li>)}
                </ul>
                <span class="card-url">
                  {`${p.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')} ↗`}
                </span>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>

  <!-- Core Practice Section -->
  <section id="work" class="section">
    <div style="margin-bottom: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem; display: flex; justify-content: space-between; align-items: baseline;">
      <h2 class="reveal" style="margin: 0; font-size: 1.85rem; font-weight: 800;">
        <span class="celeste-text" style="font-family: var(--font-mono); font-size: 0.85em; margin-right: 0.5rem;">02 //</span>
        {t.work.title}
      </h2>
      <span style="font-family: var(--font-mono); font-size: 0.76rem; color: var(--text-dim); text-transform: uppercase;">{isEs ? 'PRÁCTICA PRINCIPAL' : 'CORE PRACTICE'}</span>
    </div>
    <p class="section-intro reveal">{t.work.intro}</p>
    <ol class="areas">
      {
        t.work.areas.map((a, i) => (
          <li class="area reveal-left" style={`--delay: ${i * 80}ms`}>
            <span class="area-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="area-title">{a.title}</h3>
            <p class="area-desc">{a.desc}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Technical Content Section -->
  <section id="content" class="section">
    <div style="margin-bottom: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem; display: flex; justify-content: space-between; align-items: baseline;">
      <h2 class="reveal" style="margin: 0; font-size: 1.85rem; font-weight: 800;">
        <span class="celeste-text" style="font-family: var(--font-mono); font-size: 0.85em; margin-right: 0.5rem;">03 //</span>
        {t.content.title}
      </h2>
      <span style="font-family: var(--font-mono); font-size: 0.76rem; color: var(--text-dim); text-transform: uppercase;">{isEs ? 'DIVULGACIÓN TÉCNICA' : 'PUBLIC LEARNING'}</span>
    </div>
    <p class="section-intro reveal">{t.content.intro}</p>
    <div class="cards">
      {
        t.content.cards.map((c, i) => (
          <a
            class="card content-card reveal-zoom"
            href={c.linkKey === 'blog' ? blogUrl : profile.contentLinks[c.linkKey]}
            target={c.linkKey === 'blog' ? undefined : '_blank'}
            rel={c.linkKey === 'blog' ? undefined : 'noopener'}
            style={`--delay: ${i * 90}ms;`}
          >
            <span class="content-icon">
              <img src={`${base}icons/${c.icon}.svg`} alt="" width="26" height="26" loading="lazy" />
            </span>
            <h3>{c.name}</h3>
            <p>{c.desc}</p>
            <span class="card-action">{c.action} →</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="section">
    <div style="margin-bottom: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem; display: flex; justify-content: space-between; align-items: baseline;">
      <h2 class="reveal" style="margin: 0; font-size: 1.85rem; font-weight: 800;">
        <span class="celeste-text" style="font-family: var(--font-mono); font-size: 0.85em; margin-right: 0.5rem;">04 //</span>
        {t.about.title}
      </h2>
      <span style="font-family: var(--font-mono); font-size: 0.76rem; color: var(--text-dim); text-transform: uppercase;">{isEs ? 'CREDENCIALES Y PERFIL' : 'CREDENTIALS & PROFILE'}</span>
    </div>
    <div class="about-grid">
      <div class="reveal-left">
        <p>{t.about.p1}</p>
        <p>{t.about.p2}</p>
      </div>
      <div>
        <h3 class="reveal-right">{t.about.skillsTitle}</h3>
        <ul class="chips">
          {t.about.skills.map((s, i) => (
            <li class="reveal-zoom" style={`--delay: ${100 + i * 50}ms`}>{s}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Advisory & Contact Section -->
  <section id="contact" class="advisory-box tilt-card reveal">
    <div class="docket-stamp">{isEs ? 'CONSULTORÍA EJECUTIVA & DUE DILIGENCE' : 'EXECUTIVE ADVISORY & DUE DILIGENCE'}</div>
    <h2>{t.contact.title}</h2>
    <p>{t.contact.lead}</p>
    <div class="hero-cta" style="justify-content: center; margin-top: 1.5rem;">
      <a class="btn btn-primary btn-icon" href={`mailto:${profile.email}`}>
        <img src={`${base}icons/generic-email.svg`} alt="" width="18" height="18" />
        {t.contact.emailButton} →
      </a>
      {
        profile.socials.slice(0, 2).map((s) => (
          <a class="btn btn-ghost btn-icon" href={s.url} target="_blank" rel="noopener">
            <img src={`${base}icons/${s.icon}.svg`} alt="" width="18" height="18" />
            {s.name}
          </a>
        ))
      }
    </div>
  </section>

  <script is:inline>
    // 1. Cluster Topology Mesh (Canvas 2D, 60fps, Zero External Dependencies)
    (function initClusterMesh() {
      const canvas = document.getElementById('cluster-mesh');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const hero = document.getElementById('home');
      let width = 0;
      let height = 0;
      let dpr = window.devicePixelRatio || 1;
      let nodes = [];
      let animFrameId = null;
      let isVisible = true;
      const mouse = { x: -9999, y: -9999, active: false };

      function resize() {
        if (!hero) return;
        const rect = hero.getBoundingClientRect();
        width = rect.width;
        height = rect.height;
        dpr = window.devicePixelRatio || 1;

        canvas.width = width * dpr;
        canvas.height = height * dpr;
        canvas.style.width = width + 'px';
        canvas.style.height = height + 'px';
        ctx.scale(dpr, dpr);

        initNodes();
      }

      function initNodes() {
        nodes = [];
        const nodeCount = Math.min(48, Math.max(16, Math.floor((width * height) / 22000)));

        for (let i = 0; i < nodeCount; i++) {
          nodes.push({
            x: Math.random() * width,
            y: Math.random() * height,
            vx: (Math.random() - 0.5) * 0.45,
            vy: (Math.random() - 0.5) * 0.45,
            radius: Math.random() * 1.5 + 1.0,
            pulse: Math.random() * Math.PI * 2,
            pulseSpeed: 0.02 + Math.random() * 0.02,
            isTelemetryBeacon: i % 4 === 0,
          });
        }
      }

      function draw() {
        if (!isVisible) return;
        ctx.clearRect(0, 0, width, height);
        const isLight = document.documentElement.classList.contains('light');
        const maxDist = 145;
        const maxDistSq = maxDist * maxDist;

        // Draw connections between cluster nodes
        for (let i = 0; i < nodes.length; i++) {
          const a = nodes[i];
          for (let j = i + 1; j < nodes.length; j++) {
            const b = nodes[j];
            const dx = a.x - b.x;
            const dy = a.y - b.y;
            const distSq = dx * dx + dy * dy;

            if (distSq < maxDistSq) {
              const dist = Math.sqrt(distSq);
              const alpha = (1 - dist / maxDist) * (isLight ? 0.16 : 0.22);
              ctx.beginPath();
              ctx.moveTo(a.x, a.y);
              ctx.lineTo(b.x, b.y);
              ctx.strokeStyle = isLight
                ? `rgba(217, 119, 6, ${alpha})`
                : `rgba(245, 158, 11, ${alpha})`;
              ctx.lineWidth = 0.75;
              ctx.stroke();
            }
          }

          // Connect to cursor within radius
          if (mouse.active) {
            const mdx = a.x - mouse.x;
            const mdy = a.y - mouse.y;
            const mDistSq = mdx * mdx + mdy * mdy;
            if (mDistSq < 160 * 160) {
              const mDist = Math.sqrt(mDistSq);
              const mAlpha = (1 - mDist / 160) * 0.35;
              ctx.beginPath();
              ctx.moveTo(a.x, a.y);
              ctx.lineTo(mouse.x, mouse.y);
              ctx.strokeStyle = isLight
                ? `rgba(217, 119, 6, ${mAlpha})`
                : `rgba(251, 191, 36, ${mAlpha})`;
              ctx.lineWidth = 1;
              ctx.stroke();
            }
          }
        }

        // Draw individual nodes
        for (let i = 0; i < nodes.length; i++) {
          const n = nodes[i];
          n.x += n.vx;
          n.y += n.vy;
          n.pulse += n.pulseSpeed;

          if (n.x < 0 || n.x > width) n.vx *= -1;
          if (n.y < 0 || n.y > height) n.vy *= -1;

          const currentRadius = n.radius + Math.sin(n.pulse) * 0.4;
          ctx.beginPath();
          ctx.arc(n.x, n.y, Math.max(0.8, currentRadius), 0, Math.PI * 2);

          if (n.isTelemetryBeacon) {
            ctx.fillStyle = isLight ? '#d97706' : '#fbbf24';
            ctx.shadowColor = isLight ? 'rgba(217, 119, 6, 0.3)' : 'rgba(245, 158, 11, 0.6)';
            ctx.shadowBlur = 6;
          } else {
            ctx.fillStyle = isLight ? 'rgba(180, 83, 9, 0.7)' : 'rgba(245, 158, 11, 0.75)';
            ctx.shadowBlur = 0;
          }

          ctx.fill();
        }

        animFrameId = requestAnimationFrame(draw);
      }

      // Stop loop when hero is off-screen for 0 CPU idle consumption
      if ('IntersectionObserver' in window && hero) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              isVisible = entry.isIntersecting;
              if (isVisible && !animFrameId) {
                animFrameId = requestAnimationFrame(draw);
              } else if (!isVisible && animFrameId) {
                cancelAnimationFrame(animFrameId);
                animFrameId = null;
              }
            });
          },
          { threshold: 0.05 }
        );
        observer.observe(hero);
      }

      // Mouse interactivity over hero canvas
      if (hero && window.matchMedia('(hover: hover)').matches) {
        hero.addEventListener('mousemove', (e) => {
          const rect = hero.getBoundingClientRect();
          mouse.x = e.clientX - rect.left;
          mouse.y = e.clientY - rect.top;
          mouse.active = true;
        });
        hero.addEventListener('mouseleave', () => {
          mouse.active = false;
        });
      }

      resize();
      window.addEventListener('resize', resize);
      animFrameId = requestAnimationFrame(draw);
    })();

    // 2. 3D Tilt Card Perspective Effect (Zero-Dependency)
    (function init3DTiltCards() {
      if (!window.matchMedia('(hover: hover)').matches) return;
      const tiltCards = document.querySelectorAll('.tilt-card');

      tiltCards.forEach((card) => {
        let isHovered = false;

        card.addEventListener('mouseenter', () => {
          isHovered = true;
        });

        card.addEventListener('mousemove', (e) => {
          if (!isHovered) return;
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          const cx = rect.width / 2;
          const cy = rect.height / 2;
          const rotateX = ((y - cy) / cy) * -5.5; // max 5.5 deg
          const rotateY = ((x - cx) / cx) * 5.5; // max 5.5 deg

          card.style.transform = `perspective(1000px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) translateY(-2px)`;

          const px = ((x / rect.width) * 100).toFixed(1);
          const py = ((y / rect.height) * 100).toFixed(1);
          card.style.setProperty('--mouse-x', `${px}%`);
          card.style.setProperty('--mouse-y', `${py}%`);
        });

        card.addEventListener('mouseleave', () => {
          isHovered = false;
          card.style.transform = '';
        });
      });
    })();
  </script>
</Base>
