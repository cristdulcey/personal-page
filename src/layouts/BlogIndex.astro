---
// Blog index for one language: lists published posts with search, category filtering & pagination.
import { getCollection } from 'astro:content';
import Base from './Base.astro';
import { profile, translations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const posts = (
  await getCollection('blog', ({ id, data }) => id.startsWith(`${lang}/`) && !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Calculate unique tags and their frequencies
const tagCounts: Record<string, number> = {};
posts.forEach((p) => {
  p.data.tags.forEach((tag) => {
    const k = tag.trim().toLowerCase();
    tagCounts[k] = (tagCounts[k] || 0) + 1;
  });
});
const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);

// "es/my-post" -> "/blog/my-post/" (or "/en/blog/my-post/")
const postUrl = (id: string) =>
  `${base}${lang === 'en' ? 'en/' : ''}blog/${id.split('/').slice(1).join('/')}/`;

const locale = lang === 'es' ? 'es-CO' : 'en-US';
const dateFormat: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'long', day: 'numeric' };
---

<Base
  lang={lang}
  title={`${t.blog.title} — ${profile.name}`}
  description={t.blog.intro}
  paths={{ es: 'blog/', en: 'en/blog/' }}
>
  <header class="page-header" id="blog-controls-header">
    <!-- Ambient Morphing Glow Blobs -->
    <div class="hero-glow hero-glow-1" aria-hidden="true"></div>
    <div class="hero-glow hero-glow-2" aria-hidden="true"></div>

    <!-- Cluster Topology Network Mesh (Canvas 2D) -->
    <div class="cluster-mesh-container" aria-hidden="true">
      <canvas id="blog-cluster-mesh"></canvas>
    </div>

    <div class="docket-stamp reveal">
      {lang === 'es' ? 'REGISTRO DE ARQUITECTURA & ESCRITURA' : 'ARCHITECTURE & WRITING REGISTRY'}
    </div>
    <h1 class="reveal">{t.blog.title}</h1>
    <p class="reveal" style="--delay: 100ms">{t.blog.intro}</p>

    <!-- Search & Category Filter Controls -->
    <div class="blog-controls reveal" style="--delay: 160ms">
      <!-- Search Input -->
      <div class="blog-search-box">
        <span class="blog-search-prefix" aria-hidden="true">❯ search _</span>
        <input
          id="blog-search-input"
          class="blog-search-input"
          type="search"
          placeholder={t.blog.searchPlaceholder}
          aria-label={t.blog.searchPlaceholder}
          autocomplete="off"
          spellcheck="false"
        />
        <span class="blog-search-kbd" title="Presioná '/' para buscar">/</span>
        <button id="blog-search-clear" class="blog-search-clear" type="button" aria-label={t.blog.searchClear} title={t.blog.searchClear}>
          ✕
        </button>
      </div>

      <!-- Category & Tag Chips -->
      {
        sortedTags.length > 0 && (
          <div class="blog-categories" role="group" aria-label={t.blog.categoryLabel}>
            <button
              type="button"
              class="blog-category-chip active"
              data-tag="all"
              aria-pressed="true"
            >
              <span>{t.blog.allCategories}</span>
              <span class="chip-count">{posts.length}</span>
            </button>
            {sortedTags.map(([tag, count]) => (
              <button
                type="button"
                class="blog-category-chip"
                data-tag={tag}
                aria-pressed="false"
              >
                <span>#{tag}</span>
                <span class="chip-count">{count}</span>
              </button>
            ))}
          </div>
        )
      }

      <!-- Telemetry Results Bar & Page Size Selector -->
      <div class="blog-telemetry-bar">
        <span id="blog-telemetry-text" class="blog-telemetry-text">
          {lang === 'es' ? `TOTAL: ${posts.length} ARTÍCULOS PUBLICADOS` : `TOTAL: ${posts.length} PUBLISHED ARTICLES`}
        </span>
        <div class="blog-page-size-selector">
          <label for="blog-page-size">{t.blog.pageSizeLabel}</label>
          <select id="blog-page-size" class="blog-page-size-select" aria-label={t.blog.pageSizeLabel}>
            <option value="2">2</option>
            <option value="4" selected>4</option>
            <option value="6">6</option>
            <option value="10">10</option>
          </select>
        </div>
      </div>
    </div>
  </header>

  {
    posts.length === 0 ? (
      <p class="post-empty">{t.blog.empty}</p>
    ) : (
      <>
        <!-- No Results Found State -->
        <div id="blog-no-results" class="blog-no-results" style="display: none;">
          <p>{t.blog.noResults}</p>
          <button id="blog-reset-filters" class="btn btn-primary" type="button">
            {t.blog.resetFilters}
          </button>
        </div>

        <!-- Post Cards Grid -->
        <div id="blog-post-list" class="post-list">
          {posts.map((post, i) => (
            <article
              class="post-card tilt-card reveal-zoom"
              data-title={post.data.title.toLowerCase()}
              data-desc={post.data.description.toLowerCase()}
              data-tags={post.data.tags.join(',').toLowerCase()}
              style={`--delay: ${i * 80}ms`}
            >
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString(locale, dateFormat)}
              </time>
              <h2>
                <a href={postUrl(post.id)} style="text-decoration: none; color: inherit;">
                  {post.data.title}
                </a>
              </h2>
              <p>{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <ul class="chips chips-small">
                  {post.data.tags.map((tag) => (
                    <li>
                      <button
                        type="button"
                        class="chip-filter-btn"
                        data-tag={tag}
                        title={`Filtrar por #${tag}`}
                      >
                        #{tag}
                      </button>
                    </li>
                  ))}
                </ul>
              )}
            </article>
          ))}
        </div>

        <!-- Dynamic Pagination Bar -->
        <nav id="blog-pagination" class="blog-pagination" aria-label="Paginación del blog">
          <button id="blog-prev-btn" class="pagination-nav-btn" type="button">
            {t.blog.prevPage}
          </button>
          <div id="blog-pages-list" class="blog-pages-list">
            <!-- Dynamically populated by client script -->
          </div>
          <button id="blog-next-btn" class="pagination-nav-btn" type="button">
            {t.blog.nextPage}
          </button>
        </nav>
      </>
    )
  }

  <script is:inline define:vars={{ defaultPageSize: 4 }}>
    (function () {
      const searchInput = document.getElementById('blog-search-input');
      const searchClear = document.getElementById('blog-search-clear');
      const categoryChips = document.querySelectorAll('.blog-category-chip');
      const postCards = Array.from(document.querySelectorAll('.post-card[data-tags]'));
      const telemetryBar = document.getElementById('blog-telemetry-text');
      const emptyState = document.getElementById('blog-no-results');
      const postList = document.getElementById('blog-post-list');
      const paginationContainer = document.getElementById('blog-pagination');
      const prevBtn = document.getElementById('blog-prev-btn');
      const nextBtn = document.getElementById('blog-next-btn');
      const pagesList = document.getElementById('blog-pages-list');
      const pageSizeSelect = document.getElementById('blog-page-size');
      const resetBtn = document.getElementById('blog-reset-filters');

      if (!postCards.length) return;

      let currentQuery = '';
      let currentTag = 'all';
      let currentPage = 1;
      let pageSize = defaultPageSize || 4;

      // Read initial state from URL query parameters
      const params = new URLSearchParams(window.location.search);
      if (params.get('q')) {
        currentQuery = params.get('q').trim().toLowerCase();
        if (searchInput) searchInput.value = params.get('q');
      }
      if (params.get('tag')) {
        currentTag = params.get('tag').trim().toLowerCase();
      }
      if (params.get('page')) {
        const p = parseInt(params.get('page'), 10);
        if (!isNaN(p) && p > 0) currentPage = p;
      }
      if (params.get('size')) {
        const s = parseInt(params.get('size'), 10);
        if (!isNaN(s) && [2, 4, 6, 10].includes(s)) pageSize = s;
      }

      function syncUrl() {
        const url = new URL(window.location.href);
        if (currentQuery) url.searchParams.set('q', currentQuery);
        else url.searchParams.delete('q');

        if (currentTag && currentTag !== 'all') url.searchParams.set('tag', currentTag);
        else url.searchParams.delete('tag');

        if (currentPage > 1) url.searchParams.set('page', String(currentPage));
        else url.searchParams.delete('page');

        if (pageSize !== 4) url.searchParams.set('size', String(pageSize));
        else url.searchParams.delete('size');

        window.history.replaceState({}, '', url.toString());
      }

      function filterAndRender() {
        // 1. Filter posts
        const matched = [];
        postCards.forEach((card) => {
          const title = card.getAttribute('data-title') || '';
          const desc = card.getAttribute('data-desc') || '';
          const tags = card.getAttribute('data-tags') || '';

          const matchesQuery =
            !currentQuery ||
            title.includes(currentQuery) ||
            desc.includes(currentQuery) ||
            tags.includes(currentQuery);

          const matchesTag =
            currentTag === 'all' ||
            tags
              .split(',')
              .map((t) => t.trim())
              .includes(currentTag);

          if (matchesQuery && matchesTag) {
            matched.push(card);
          }
        });

        const totalResults = matched.length;
        const totalPages = Math.ceil(totalResults / pageSize) || 1;
        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        const startIndex = (currentPage - 1) * pageSize;
        const endIndex = startIndex + pageSize;

        // 2. Manage card visibility for pagination
        postCards.forEach((card) => {
          card.style.display = 'none';
        });

        matched.forEach((card, index) => {
          if (index >= startIndex && index < endIndex) {
            card.style.display = 'flex';
          }
        });

        // 3. Toggle empty state
        if (emptyState) emptyState.style.display = totalResults === 0 ? 'block' : 'none';
        if (postList) postList.style.display = totalResults === 0 ? 'none' : 'grid';

        // 4. Update category chips
        categoryChips.forEach((chip) => {
          const tag = chip.getAttribute('data-tag') || 'all';
          if (tag === currentTag) {
            chip.classList.add('active');
            chip.setAttribute('aria-pressed', 'true');
          } else {
            chip.classList.remove('active');
            chip.setAttribute('aria-pressed', 'false');
          }
        });

        // 5. Update clear search button
        if (searchClear) searchClear.style.display = currentQuery ? 'block' : 'none';

        // 6. Update telemetry text
        if (telemetryBar) {
          const start = totalResults === 0 ? 0 : startIndex + 1;
          const end = Math.min(endIndex, totalResults);
          const tagLabel = currentTag === 'all' ? 'TODOS' : `#${currentTag.toUpperCase()}`;
          const queryLabel = currentQuery ? ` // QUERY: "${currentQuery}"` : '';
          telemetryBar.textContent = `RESULTADOS: ${start}–${end} DE ${totalResults} // FILTRO: ${tagLabel}${queryLabel}`;
        }

        // 7. Render pagination controls
        if (paginationContainer) {
          if (totalPages <= 1) {
            paginationContainer.style.display = 'none';
          } else {
            paginationContainer.style.display = 'flex';

            if (prevBtn) prevBtn.disabled = currentPage <= 1;
            if (nextBtn) nextBtn.disabled = currentPage >= totalPages;

            if (pagesList) {
              pagesList.innerHTML = '';
              for (let i = 1; i <= totalPages; i++) {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = `pagination-btn ${i === currentPage ? 'active' : ''}`;
                btn.textContent = String(i);
                btn.setAttribute('aria-label', `Página ${i}`);
                btn.addEventListener('click', () => {
                  currentPage = i;
                  filterAndRender();
                  syncUrl();
                  scrollToControls();
                });
                pagesList.appendChild(btn);
              }
            }
          }
        }

        if (pageSizeSelect) {
          pageSizeSelect.value = String(pageSize);
        }
      }

      function scrollToControls() {
        const target = document.getElementById('blog-controls-header');
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }

      // Input listener with debouncing
      if (searchInput) {
        let timer;
        searchInput.addEventListener('input', (e) => {
          clearTimeout(timer);
          timer = setTimeout(() => {
            currentQuery = e.target.value.trim().toLowerCase();
            currentPage = 1;
            filterAndRender();
            syncUrl();
          }, 120);
        });

        searchInput.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            searchInput.value = '';
            currentQuery = '';
            currentPage = 1;
            filterAndRender();
            syncUrl();
          }
        });
      }

      if (searchClear) {
        searchClear.addEventListener('click', () => {
          if (searchInput) searchInput.value = '';
          currentQuery = '';
          currentPage = 1;
          filterAndRender();
          syncUrl();
          if (searchInput) searchInput.focus();
        });
      }

      categoryChips.forEach((chip) => {
        chip.addEventListener('click', () => {
          currentTag = chip.getAttribute('data-tag') || 'all';
          currentPage = 1;
          filterAndRender();
          syncUrl();
        });
      });

      // Filter clicks from inside card tag chips
      document.querySelectorAll('.chip-filter-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const tag = btn.getAttribute('data-tag');
          if (tag) {
            currentTag = tag.trim().toLowerCase();
            currentPage = 1;
            filterAndRender();
            syncUrl();
            scrollToControls();
          }
        });
      });

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          currentQuery = '';
          currentTag = 'all';
          currentPage = 1;
          if (searchInput) searchInput.value = '';
          filterAndRender();
          syncUrl();
        });
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          if (currentPage > 1) {
            currentPage--;
            filterAndRender();
            syncUrl();
            scrollToControls();
          }
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          currentPage++;
          filterAndRender();
          syncUrl();
          scrollToControls();
        });
      }

      if (pageSizeSelect) {
        pageSizeSelect.addEventListener('change', (e) => {
          pageSize = parseInt(e.target.value, 10) || 4;
          currentPage = 1;
          filterAndRender();
          syncUrl();
        });
      }

      // Keyboard shortcut: '/' focuses search
      window.addEventListener('keydown', (e) => {
        if (
          e.key === '/' &&
          document.activeElement !== searchInput &&
          !['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)
        ) {
          e.preventDefault();
          if (searchInput) {
            searchInput.focus();
            searchInput.select();
          }
        }
      });

      // Initial filter & render
      filterAndRender();
    })();

    // 2. Blog Header Cluster Topology Mesh (Canvas 2D)
    (function initBlogClusterMesh() {
      const canvas = document.getElementById('blog-cluster-mesh');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const header = document.getElementById('blog-controls-header');
      let width = 0;
      let height = 0;
      let dpr = window.devicePixelRatio || 1;
      let nodes = [];
      let animFrameId = null;
      let isVisible = true;
      const mouse = { x: -9999, y: -9999, active: false };

      function resize() {
        if (!header) return;
        const rect = header.getBoundingClientRect();
        width = rect.width;
        height = rect.height;
        dpr = window.devicePixelRatio || 1;

        canvas.width = width * dpr;
        canvas.height = height * dpr;
        canvas.style.width = width + 'px';
        canvas.style.height = height + 'px';
        ctx.scale(dpr, dpr);

        initNodes();
      }

      function initNodes() {
        nodes = [];
        const nodeCount = Math.min(36, Math.max(14, Math.floor((width * height) / 22000)));

        for (let i = 0; i < nodeCount; i++) {
          nodes.push({
            x: Math.random() * width,
            y: Math.random() * height,
            vx: (Math.random() - 0.5) * 0.4,
            vy: (Math.random() - 0.5) * 0.4,
            radius: Math.random() * 1.5 + 1.0,
            pulse: Math.random() * Math.PI * 2,
            pulseSpeed: 0.02 + Math.random() * 0.02,
            isTelemetryBeacon: i % 4 === 0,
          });
        }
      }

      function draw() {
        if (!isVisible) return;
        ctx.clearRect(0, 0, width, height);
        const isLight = document.documentElement.classList.contains('light');
        const maxDist = 140;
        const maxDistSq = maxDist * maxDist;

        // Connections
        for (let i = 0; i < nodes.length; i++) {
          const a = nodes[i];
          for (let j = i + 1; j < nodes.length; j++) {
            const b = nodes[j];
            const dx = a.x - b.x;
            const dy = a.y - b.y;
            const distSq = dx * dx + dy * dy;

            if (distSq < maxDistSq) {
              const dist = Math.sqrt(distSq);
              const alpha = (1 - dist / maxDist) * (isLight ? 0.15 : 0.2);
              ctx.beginPath();
              ctx.moveTo(a.x, a.y);
              ctx.lineTo(b.x, b.y);
              ctx.strokeStyle = isLight
                ? `rgba(217, 119, 6, ${alpha})`
                : `rgba(245, 158, 11, ${alpha})`;
              ctx.lineWidth = 0.75;
              ctx.stroke();
            }
          }

          if (mouse.active) {
            const mdx = a.x - mouse.x;
            const mdy = a.y - mouse.y;
            const mDistSq = mdx * mdx + mdy * mdy;
            if (mDistSq < 150 * 150) {
              const mDist = Math.sqrt(mDistSq);
              const mAlpha = (1 - mDist / 150) * 0.3;
              ctx.beginPath();
              ctx.moveTo(a.x, a.y);
              ctx.lineTo(mouse.x, mouse.y);
              ctx.strokeStyle = isLight
                ? `rgba(217, 119, 6, ${mAlpha})`
                : `rgba(251, 191, 36, ${mAlpha})`;
              ctx.lineWidth = 1;
              ctx.stroke();
            }
          }
        }

        // Nodes
        for (let i = 0; i < nodes.length; i++) {
          const n = nodes[i];
          n.x += n.vx;
          n.y += n.vy;
          n.pulse += n.pulseSpeed;

          if (n.x < 0 || n.x > width) n.vx *= -1;
          if (n.y < 0 || n.y > height) n.vy *= -1;

          const currentRadius = n.radius + Math.sin(n.pulse) * 0.4;
          ctx.beginPath();
          ctx.arc(n.x, n.y, Math.max(0.8, currentRadius), 0, Math.PI * 2);

          if (n.isTelemetryBeacon) {
            ctx.fillStyle = isLight ? '#d97706' : '#fbbf24';
            ctx.shadowColor = isLight ? 'rgba(217, 119, 6, 0.3)' : 'rgba(245, 158, 11, 0.6)';
            ctx.shadowBlur = 6;
          } else {
            ctx.fillStyle = isLight ? 'rgba(180, 83, 9, 0.7)' : 'rgba(245, 158, 11, 0.75)';
            ctx.shadowBlur = 0;
          }

          ctx.fill();
        }

        animFrameId = requestAnimationFrame(draw);
      }

      // Stop loop when header is off-screen
      if ('IntersectionObserver' in window && header) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              isVisible = entry.isIntersecting;
              if (isVisible && !animFrameId) {
                animFrameId = requestAnimationFrame(draw);
              } else if (!isVisible && animFrameId) {
                cancelAnimationFrame(animFrameId);
                animFrameId = null;
              }
            });
          },
          { threshold: 0.05 }
        );
        observer.observe(header);
      }

      if (header && window.matchMedia('(hover: hover)').matches) {
        header.addEventListener('mousemove', (e) => {
          const rect = header.getBoundingClientRect();
          mouse.x = e.clientX - rect.left;
          mouse.y = e.clientY - rect.top;
          mouse.active = true;
        });
        header.addEventListener('mouseleave', () => {
          mouse.active = false;
        });
      }

      resize();
      window.addEventListener('resize', resize);
      animFrameId = requestAnimationFrame(draw);
    })();

    // 3. Blog Cards 3D Tilt Effect (Zero-Dependency, RAF Optimized)
    (function initBlogTiltCards() {
      if (!window.matchMedia('(hover: hover)').matches) return;
      const tiltCards = document.querySelectorAll('.tilt-card');

      tiltCards.forEach((card) => {
        let rect = null;
        let rafId = null;
        let mouseX = 0;
        let mouseY = 0;

        function updateTransform() {
          if (!rect) return;
          const cx = rect.width / 2;
          const cy = rect.height / 2;
          const rotateX = ((mouseY - cy) / cy) * -4.5;
          const rotateY = ((mouseX - cx) / cx) * 4.5;

          card.style.transform = `perspective(1000px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) translateY(-2px)`;

          const px = ((mouseX / rect.width) * 100).toFixed(1);
          const py = ((mouseY / rect.height) * 100).toFixed(1);
          card.style.setProperty('--mouse-x', `${px}%`);
          card.style.setProperty('--mouse-y', `${py}%`);

          rafId = null;
        }

        card.addEventListener('mouseenter', () => {
          card.classList.remove('is-resetting');
          rect = card.getBoundingClientRect();
        });

        card.addEventListener('mousemove', (e) => {
          if (!rect) rect = card.getBoundingClientRect();
          mouseX = e.clientX - rect.left;
          mouseY = e.clientY - rect.top;

          if (!rafId) {
            rafId = requestAnimationFrame(updateTransform);
          }
        });

        card.addEventListener('mouseleave', () => {
          if (rafId) {
            cancelAnimationFrame(rafId);
            rafId = null;
          }
          rect = null;
          card.classList.add('is-resetting');
          card.style.transform = '';
          card.style.removeProperty('--mouse-x');
          card.style.removeProperty('--mouse-y');
        });
      });
    })();
  </script>
</Base>
