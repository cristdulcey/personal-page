---
// Blog index for one language: lists the published posts, newest first.
import { getCollection } from 'astro:content';
import Base from './Base.astro';
import { profile, translations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const posts = (
  await getCollection('blog', ({ id, data }) => id.startsWith(`${lang}/`) && !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// "es/my-post" -> "/blog/my-post/" (or "/en/blog/my-post/")
const postUrl = (id: string) =>
  `${base}${lang === 'en' ? 'en/' : ''}blog/${id.split('/').slice(1).join('/')}/`;

const locale = lang === 'es' ? 'es-CO' : 'en-US';
const dateFormat: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'long', day: 'numeric' };
---

<Base
  lang={lang}
  title={`${t.blog.title} — ${profile.name}`}
  description={t.blog.intro}
  paths={{ es: 'blog/', en: 'en/blog/' }}
>
  <header class="page-header">
    <h1 class="reveal">{t.blog.title}</h1>
    <p class="reveal" style="--delay: 100ms">{t.blog.intro}</p>
  </header>

  {
    posts.length === 0 ? (
      <p class="post-empty">{t.blog.empty}</p>
    ) : (
      <div class="post-list">
        {posts.map((post, i) => (
          <a class="post-card reveal" href={postUrl(post.id)} style={`--delay: ${i * 80}ms`}>
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString(locale, dateFormat)}
            </time>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <ul class="chips chips-small">
                {post.data.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            )}
          </a>
        ))}
      </div>
    )
  }
</Base>
