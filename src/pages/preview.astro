---
// Preview Hub: Design Alternatives Comparison
const pageTitle = "Cristian Dulcey — Design Alternatives Showcase";
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #090c10;
      --card-bg: #121720;
      --border: rgba(255, 255, 255, 0.1);
      --text: #f0f6fc;
      --text-muted: #94a3b8;
      --accent: #3b82f6;
      --font-sans: 'Plus Jakarta Sans', system-ui, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-sans);
      padding: 3rem 1.5rem 5rem;
      line-height: 1.6;
    }
    .container {
      max-width: 960px;
      margin: 0 auto;
    }
    .header {
      margin-bottom: 3rem;
      border-bottom: 1px solid var(--border);
      padding-bottom: 1.5rem;
    }
    .badge {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 0.5rem;
      display: inline-block;
    }
    h1 {
      font-size: clamp(2rem, 5vw, 3.25rem);
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 0.75rem;
    }
    p.lead {
      color: var(--text-muted);
      font-size: 1.1rem;
      max-width: 680px;
    }
    .grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.75rem;
      margin-top: 2rem;
    }
    @media (min-width: 768px) {
      .grid { grid-template-columns: repeat(3, 1fr); }
    }
    .card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.2s, border-color 0.2s;
      text-decoration: none;
      color: inherit;
    }
    .card:hover {
      transform: translateY(-4px);
      border-color: rgba(255, 255, 255, 0.3);
    }
    .card-num {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      font-weight: 700;
      margin-bottom: 0.75rem;
      display: block;
    }
    .card-1 .card-num { color: #f59e0b; }
    .card-2 .card-num { color: #3b82f6; }
    .card-3 .card-num { color: #b45309; }
    .card-title {
      font-size: 1.35rem;
      font-weight: 800;
      margin-bottom: 0.5rem;
    }
    .card-desc {
      color: var(--text-muted);
      font-size: 0.9rem;
      line-height: 1.5;
      margin-bottom: 1.5rem;
    }
    .palette-strip {
      display: flex;
      gap: 0.4rem;
      margin-bottom: 1.25rem;
    }
    .dot {
      width: 16px;
      height: 16px;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.2);
    }
    .btn-view {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      font-weight: 700;
      padding: 0.65rem 1rem;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 6px;
      text-align: center;
      transition: background 0.15s;
    }
    .card:hover .btn-view {
      background: #ffffff;
      color: #000000;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <span class="badge">DESIGN LAB // EXPLORACIÓN DE DIRECCIONES</span>
      <h1>Alternativas de Diseño</h1>
      <p class="lead">
        Tres mundos visuales independientes, construidos en código limpio para evaluar en vivo desde tu celular.
      </p>
    </div>

    <div class="grid">
      <!-- 01 Aerospace -->
      <a href="/preview-aerospace/" class="card card-1">
        <div>
          <span class="card-num">01. DIRECCIÓN ASIGNADA</span>
          <h2 class="card-title">Aerospace Docket</h2>
          <p class="card-desc">
            Sistemas de misión crítica con tolerancia cero a fallos. Paleta carbono/titanio con acentos ámbar iridio y tipografía técnica de alta precisión.
          </p>
          <div class="palette-strip">
            <div class="dot" style="background: #07090e;"></div>
            <div class="dot" style="background: #0d111a;"></div>
            <div class="dot" style="background: #f59e0b;"></div>
            <div class="dot" style="background: #f1f5f9;"></div>
          </div>
        </div>
        <div class="btn-view">Explorar Aeroespacial →</div>
      </a>

      <!-- 02 Monolith -->
      <a href="/preview-monolith/" class="card card-2">
        <div>
          <span class="card-num">02. MONOLITO INSTITUCIONAL</span>
          <h2 class="card-title">Sovereign Monolith</h2>
          <p class="card-desc">
            Solemnidad arquitectónica y prestigio bancario/estatal. Pizarra grafito profunda, blanco hueso y cobalto soberano con estructura de ledger inmutable.
          </p>
          <div class="palette-strip">
            <div class="dot" style="background: #090c10;"></div>
            <div class="dot" style="background: #151b23;"></div>
            <div class="dot" style="background: #2563eb;"></div>
            <div class="dot" style="background: #f0f6fc;"></div>
          </div>
        </div>
        <div class="btn-view">Explorar Monolito →</div>
      </a>

      <!-- 03 Editorial Light -->
      <a href="/preview-editorial-light/" class="card card-3">
        <div>
          <span class="card-num">03. MONOGRAFÍA EDITORIAL</span>
          <h2 class="card-title">Editorial Claro</h2>
          <p class="card-desc">
            Edición en modo claro inspirada en Stripe Press y Harvard Business Review. Marfil institucional cálido, tinta carbón profunda y máxima legibilidad intelectual.
          </p>
          <div class="palette-strip">
            <div class="dot" style="background: #fcfbf9;"></div>
            <div class="dot" style="background: #111827;"></div>
            <div class="dot" style="background: #b45309;"></div>
            <div class="dot" style="background: #e7e5e0;"></div>
          </div>
        </div>
        <div class="btn-view">Explorar Editorial Claro →</div>
      </a>
    </div>
  </div>
</body>
</html>
