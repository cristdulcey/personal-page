---
// Preview: Sovereign Institutional Monolith
const pageTitle = "Cristian Dulcey — Sovereign Systems Architecture";
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #090c10;
      --surface: #0e1218;
      --surface-elevated: #151b23;
      --border: rgba(255, 255, 255, 0.1);
      --border-strong: rgba(255, 255, 255, 0.22);
      --cobalt: #2563eb;
      --cobalt-glow: rgba(37, 99, 235, 0.2);
      --cobalt-bright: #3b82f6;
      --text: #f0f6fc;
      --text-muted: #8b949e;
      --text-dim: #6e7681;
      --font-serif: 'Cinzel', serif;
      --font-sans: 'Inter', system-ui, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: var(--font-sans);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      padding-bottom: 5rem;
    }

    /* Top Institutional Seal */
    .top-seal {
      border-bottom: 1px solid var(--border);
      background: var(--bg);
      padding: 1rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .seal-brand {
      font-family: var(--font-serif);
      font-size: 1rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      color: #ffffff;
      text-transform: uppercase;
    }
    .seal-meta {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--text-dim);
      letter-spacing: 0.05em;
    }

    .container {
      max-width: 1040px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    /* Hero Monolith */
    .hero {
      padding: 4.5rem 0 3.5rem;
      border-bottom: 1px solid var(--border);
    }
    .hero-eyebrow {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: var(--cobalt-bright);
      text-transform: uppercase;
      letter-spacing: 0.2em;
      margin-bottom: 1.25rem;
      display: block;
    }
    .hero-headline {
      font-family: var(--font-serif);
      font-size: clamp(2.3rem, 6vw, 4.2rem);
      font-weight: 800;
      line-height: 1.1;
      letter-spacing: -0.01em;
      color: #ffffff;
      margin-bottom: 1.5rem;
    }
    .hero-statement {
      font-size: clamp(1.1rem, 2vw, 1.35rem);
      color: var(--text-muted);
      max-width: 760px;
      line-height: 1.6;
      font-weight: 400;
    }

    /* Institutional Ledger Grid */
    .ledger-grid {
      display: grid;
      grid-template-columns: repeat(1, 1fr);
      border: 1px solid var(--border);
      background: var(--surface);
      margin-top: 3rem;
    }
    @media (min-width: 640px) {
      .ledger-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (min-width: 960px) {
      .ledger-grid { grid-template-columns: repeat(4, 1fr); }
    }
    .ledger-cell {
      padding: 1.75rem 1.5rem;
      border: 1px solid var(--border);
      position: relative;
    }
    .ledger-cell:hover {
      background: var(--surface-elevated);
    }
    .ledger-label {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--text-dim);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      display: block;
      margin-bottom: 0.5rem;
    }
    .ledger-val {
      font-family: var(--font-serif);
      font-size: 2rem;
      font-weight: 800;
      color: #ffffff;
      line-height: 1;
      margin-bottom: 0.4rem;
    }
    .ledger-desc {
      font-size: 0.82rem;
      color: var(--text-muted);
    }

    /* Cases Section */
    .section-head {
      padding: 4rem 0 1.5rem;
      border-bottom: 2px solid var(--border-strong);
      margin-bottom: 2rem;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
    }
    .section-head h2 {
      font-family: var(--font-serif);
      font-size: 1.8rem;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: 0.04em;
    }
    .section-head span {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--cobalt-bright);
    }

    /* Monolith Project Cards */
    .monolith-card {
      border: 1px solid var(--border);
      background: var(--surface);
      padding: 2.25rem;
      margin-bottom: 2rem;
      position: relative;
      transition: border-color 0.2s;
    }
    .monolith-card:hover {
      border-color: var(--border-strong);
    }
    .monolith-card-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }
    .project-index {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--cobalt-bright);
      font-weight: 700;
    }
    .project-title {
      font-family: var(--font-serif);
      font-size: 1.85rem;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 0.75rem;
      letter-spacing: 0.02em;
    }
    .project-narrative {
      color: var(--text-muted);
      font-size: 1rem;
      line-height: 1.7;
      margin-bottom: 1.5rem;
      max-width: 800px;
    }
    .audit-strip {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
      background: rgba(0,0,0,0.4);
      padding: 1.25rem;
      border: 1px solid var(--border);
    }
    @media (min-width: 640px) {
      .audit-strip { grid-template-columns: repeat(4, 1fr); }
    }
    .audit-item span {
      display: block;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--text-dim);
      text-transform: uppercase;
    }
    .audit-item strong {
      font-size: 0.92rem;
      color: #ffffff;
      font-weight: 600;
    }

    /* Advisory Box */
    .advisory-frame {
      border: 1px solid var(--cobalt);
      background: var(--surface);
      padding: 3rem 2rem;
      text-align: center;
      margin-top: 4rem;
    }
    .advisory-frame h3 {
      font-family: var(--font-serif);
      font-size: 1.85rem;
      font-weight: 800;
      margin-bottom: 1rem;
      color: #ffffff;
    }
    .advisory-frame p {
      color: var(--text-muted);
      max-width: 640px;
      margin: 0 auto 2rem;
      font-size: 1.05rem;
    }
    .btn-monolith {
      display: inline-block;
      font-family: var(--font-serif);
      font-weight: 800;
      font-size: 0.95rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      background: var(--cobalt);
      color: #ffffff;
      padding: 0.95rem 2.25rem;
      text-decoration: none;
      transition: background 0.15s;
    }
    .btn-monolith:hover {
      background: var(--cobalt-bright);
    }

    /* Preview Navigation */
    .preview-nav {
      position: fixed;
      bottom: 1rem;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(9, 12, 16, 0.95);
      border: 1px solid var(--cobalt);
      padding: 0.5rem 1rem;
      border-radius: 50px;
      display: flex;
      gap: 0.75rem;
      box-shadow: 0 10px 30px rgba(0,0,0,0.8);
      z-index: 100;
      font-family: var(--font-mono);
      font-size: 0.75rem;
    }
    .preview-nav a {
      color: var(--text-muted);
      text-decoration: none;
      padding: 0.25rem 0.5rem;
      border-radius: 20px;
      transition: color 0.15s;
    }
    .preview-nav a.active {
      background: var(--cobalt);
      color: #ffffff;
      font-weight: 700;
    }
  </style>
</head>
<body>

  <!-- Top Seal -->
  <header class="top-seal">
    <div class="seal-brand">CRISTIAN DULCEY // ARCHITECT</div>
    <div class="seal-meta">SOVEREIGN & ENTERPRISE INFRASTRUCTURE</div>
  </header>

  <main class="container">
    <!-- Hero -->
    <section class="hero">
      <span class="hero-eyebrow">DISTRIBUTED SYSTEMS MONOLITH</span>
      <h1 class="hero-headline">Sovereign Architecture for Critical Infrastructure.</h1>
      <p class="hero-statement">
        Lead Systems Architect, Microsoft MVP y Google Developer Expert (GDE). Especialista en ingeniería de resiliencia, reconciliación transaccional distribuida y escalabilidad masiva en entornos regulados y de alta demanda.
      </p>

      <!-- Ledger Grid -->
      <div class="ledger-grid">
        <div class="ledger-cell">
          <span class="ledger-label">Audited Citizens</span>
          <div class="ledger-val">4.0M+</div>
          <div class="ledger-desc">Usuarios Chivo Wallet</div>
        </div>
        <div class="ledger-cell">
          <span class="ledger-label">Orchestrated Mesh</span>
          <div class="ledger-val">300+</div>
          <div class="ledger-desc">Microservicios Azure K8s</div>
        </div>
        <div class="ledger-cell">
          <span class="ledger-label">Throughput Peak</span>
          <div class="ledger-val">100K+</div>
          <div class="ledger-desc">Peticiones concurrentes</div>
        </div>
        <div class="ledger-cell">
          <span class="ledger-label">Industry Tenure</span>
          <div class="ledger-val">15+</div>
          <div class="ledger-desc">Años de arquitectura</div>
        </div>
      </div>
    </section>

    <!-- Cases -->
    <section>
      <div class="section-head">
        <h2>SISTEMAS AUDITADOS</h2>
        <span>CASE REGISTRY // PRODUCTION</span>
      </div>

      <!-- Case 01: Chivo -->
      <article class="monolith-card">
        <div class="monolith-card-top">
          <span class="project-index">LEDGER-RECORD #001</span>
          <span style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-dim);">NATIONAL LEGAL TENDER</span>
        </div>
        <h3 class="project-title">Chivo Wallet — Sovereign Financial Infrastructure</h3>
        <p class="project-narrative">
          Liderazgo y diseño de la arquitectura para los sistemas de backend de soporte y liquidación bancaria del ecosistema Bitcoin legal tender en El Salvador. Implementación de ledger transaccional idempotente garantizando cero discrepancias contables en transferencias interbancarias y de red Lightning.
        </p>
        <div class="audit-strip">
          <div class="audit-item">
            <span>Escala:</span>
            <strong>4M+ Ciudadanos</strong>
          </div>
          <div class="audit-item">
            <span>Consistencia:</span>
            <strong>Idempotencia Estricta</strong>
          </div>
          <div class="audit-item">
            <span>Integración:</span>
            <strong>Lightning / Core Banking</strong>
          </div>
          <div class="audit-item">
            <span>Estado:</span>
            <strong>Producción Nacional</strong>
          </div>
        </div>
      </article>

      <!-- Case 02: Fenix -->
      <article class="monolith-card">
        <div class="monolith-card-top">
          <span class="project-index">LEDGER-RECORD #002</span>
          <span style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-dim);">ENTERPRISE PLATFORM</span>
        </div>
        <h3 class="project-title">Proyecto Fénix — Malla Empresarial de Alta Resiliencia</h3>
        <p class="project-narrative">
          Arquitectura, particionado y orquestación de más de 300 microservicios distribuidos en Azure Kubernetes Service para soportar cargas operativas concurrentes extremas sin degradación ni pérdida de estado.
        </p>
        <div class="audit-strip">
          <div class="audit-item">
            <span>Clúster:</span>
            <strong>300+ Microservicios</strong>
          </div>
          <div class="audit-item">
            <span>Concurrencia:</span>
            <strong>100,000+ req/s</strong>
          </div>
          <div class="audit-item">
            <span>Disponibilidad:</span>
            <strong>99.99% Enterprise SLA</strong>
          </div>
          <div class="audit-item">
            <span>Infraestructura:</span>
            <strong>Multi-Región AKS</strong>
          </div>
        </div>
      </article>
    </section>

    <!-- Advisory -->
    <section class="advisory-frame">
      <h3>CONSULTORÍA & ADVISORY ARQUITECTÓNICO</h3>
      <p>
        Disponible para revisiones arquitectónicas críticas, auditorías de resiliencia y diseño estratégico de plataformas distribuidas para comités ejecutivos y directores de ingeniería.
      </p>
      <a href="mailto:christian.dulcey@gmail.com" class="btn-monolith">
        Contactar para Advisory
      </a>
    </section>
  </main>

  <!-- Navigation -->
  <nav class="preview-nav">
    <a href="/preview-aerospace/">01. Aeroespacial</a>
    <a href="/preview-monolith/" class="active">02. Monolito</a>
    <a href="/preview-editorial-light/">03. Editorial Claro</a>
  </nav>

</body>
</html>
