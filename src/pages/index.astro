---
// Ruta base del sitio en GitHub Pages, con barra final garantizada
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

// Edita estos datos con tu información real
const perfil = {
  nombre: 'Cristian Dulcey',
  rol: 'Desarrollador de software y creador de contenido',
  descripcion:
    'Desarrollador de software colombiano con experiencia construyendo productos digitales de principio a fin: desde la infraestructura y el despliegue hasta las aplicaciones web y móviles que usan las personas todos los días.',
  ubicacion: 'Colombia',
  foto: `${base}cristian.jpg`,
  correo: 'me@cristdulcey.com',
};

const redes = [
  { nombre: 'GitHub', url: 'https://github.com/cristdulcey', icono: 'github' },
  { nombre: 'LinkedIn', url: 'https://www.linkedin.com/in/cristdulcey/', icono: 'linkedin' },
  { nombre: 'YouTube', url: 'https://www.youtube.com/@cristdulcey', icono: 'youtube' },
  { nombre: 'X', url: 'https://twitter.com/cristdulcey', icono: 'x' },
  { nombre: 'Instagram', url: 'https://www.instagram.com/cristdulcey/', icono: 'instagram' },
  { nombre: 'Medium', url: 'https://medium.com/@cristdulcey', icono: 'medium' },
];

const apoyo = [
  { nombre: 'Cómprame un café', url: 'https://bmc.link/cristdulcey', icono: 'buy-me-a-coffee' },
  {
    nombre: 'PayPal',
    url: 'https://www.paypal.com/donate/?business=DP8D4YH6HJJVC&no_recurring=0&item_name=Si+crees+que+te+ayude+en+algo%2C+puedes+sentirte+libre+de+apoyarme+con+lo+que+quieras&currency_code=USD',
    icono: 'paypal',
  },
];

const servicios = [
  {
    icono: '🤖',
    titulo: 'DevOps e infraestructura',
    desc: 'Automatización de despliegues, integración continua y operación de aplicaciones en la nube.',
  },
  {
    icono: '🐍',
    titulo: 'Backend con Python',
    desc: 'APIs, automatizaciones y procesamiento de datos.',
  },
  {
    icono: '🖥️',
    titulo: 'Frontend con Vue y React',
    desc: 'Interfaces web modernas y responsivas.',
  },
  {
    icono: '📱',
    titulo: 'Apps móviles',
    desc: 'Desarrollo iOS con Swift y Android con Java.',
  },
  {
    icono: '🖼️',
    titulo: 'Web3',
    desc: 'Desarrollo con tokens y NFTs sobre contratos inteligentes.',
  },
  {
    icono: '💬',
    titulo: 'Chatbots',
    desc: 'Asistentes conversacionales e integraciones con plataformas de mensajería y redes sociales.',
  },
];

const contenido = [
  {
    nombre: 'YouTube',
    desc: 'Videos sobre desarrollo de software, DevOps y tecnología.',
    url: 'https://www.youtube.com/@cristdulcey',
    icono: 'youtube',
    accion: 'Ver canal',
    brillo: 'rgba(255, 0, 51, 0.35)',
  },
  {
    nombre: 'Medium',
    desc: 'Artículos técnicos y tutoriales sobre lo que voy aprendiendo.',
    url: 'https://medium.com/@cristdulcey',
    icono: 'medium',
    accion: 'Leer artículos',
    brillo: 'rgba(2, 184, 117, 0.35)',
  },
  {
    nombre: 'GitHub',
    desc: 'Mis proyectos de código abierto.',
    url: 'https://github.com/cristdulcey',
    icono: 'github',
    accion: 'Ver repositorios',
    brillo: 'rgba(167, 139, 250, 0.35)',
  },
];

const proyectos = [
  {
    titulo: 'Proyecto uno',
    descripcion:
      'Describe aquí tu proyecto destacado: qué problema resuelve, con qué tecnología lo construiste y qué lo hace especial.',
    tags: ['Python', 'DevOps'],
    enlace: '#',
  },
  {
    titulo: 'Proyecto dos',
    descripcion:
      'Otro proyecto del que te sientas orgulloso. Puedes enlazar al repositorio o a la demo en vivo.',
    tags: ['Vue', 'Web3'],
    enlace: '#',
  },
  {
    titulo: 'Proyecto tres',
    descripcion:
      'Añade o quita tarjetas según necesites: son objetos en un arreglo al inicio de este archivo.',
    tags: ['Swift', 'Android'],
    enlace: '#',
  },
];

const habilidades = [
  'Python',
  'Vue y React',
  'Swift (iOS)',
  'Java (Android)',
  'DevOps / CI-CD',
  'Nube y despliegues',
  'Web3 y smart contracts',
  'Chatbots',
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={perfil.descripcion} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{perfil.nombre} — {perfil.rol}</title>
  </head>
  <body>
    <div class="aurora" aria-hidden="true"></div>

    <header class="nav">
      <nav>
        <a class="logo" href="#inicio">CD<span class="dot">.</span></a>
        <ul>
          <li><a href="#que-hago">Qué hago</a></li>
          <li><a href="#proyectos">Proyectos</a></li>
          <li><a href="#contenido">Contenido</a></li>
          <li><a href="#contacto">Contacto</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <section id="inicio" class="hero">
        <div class="hero-texto">
          <p class="hero-kicker reveal">Hola, soy</p>
          <h1 class="reveal" style="--delay: 80ms">{perfil.nombre}</h1>
          <p class="hero-rol reveal" style="--delay: 160ms">
            <span class="gradient-text">{perfil.rol}</span>
          </p>
          <p class="hero-desc reveal" style="--delay: 240ms">{perfil.descripcion}</p>
          <div class="hero-cta reveal" style="--delay: 320ms">
            <a class="btn btn-primary" href="#que-hago">Qué hago</a>
            <a class="btn btn-ghost" href="#contacto">Contactar</a>
          </div>
          <ul class="redes reveal" style="--delay: 400ms" aria-label="Redes sociales">
            {
              redes.map((r) => (
                <li>
                  <a href={r.url} target="_blank" rel="noopener" title={r.nombre} aria-label={r.nombre}>
                    <img src={`${base}icons/${r.icono}.svg`} alt="" width="22" height="22" loading="lazy" />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="hero-foto reveal" style="--delay: 200ms">
          <img src={perfil.foto} alt={`Foto de ${perfil.nombre}`} width="320" height="320" />
        </div>
      </section>

      <section id="que-hago" class="section">
        <h2 class="reveal"><span class="section-num">01</span> Qué hago</h2>
        <p class="section-intro reveal">
          Además de escribir código, creo contenido para compartir lo que aprendo.
          Estas son las áreas en las que trabajo:
        </p>
        <ol class="areas">
          {
            servicios.map((s, i) => (
              <li class="area reveal" style={`--delay: ${i * 80}ms`}>
                <span class="area-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="area-titulo">{s.titulo}</h3>
                <p class="area-desc">{s.desc}</p>
                <span class="area-icono" aria-hidden="true">{s.icono}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="proyectos" class="section">
        <h2 class="reveal"><span class="section-num">02</span> Proyectos</h2>
        <div class="cards">
          {
            proyectos.map((p, i) => (
              <a class="card reveal" href={p.enlace} style={`--delay: ${i * 90}ms`}>
                <h3>{p.titulo}</h3>
                <p>{p.descripcion}</p>
                <ul class="chips chips-small">
                  {p.tags.map((t) => <li>{t}</li>)}
                </ul>
              </a>
            ))
          }
        </div>
      </section>

      <section id="contenido" class="section">
        <h2 class="reveal"><span class="section-num">03</span> Mi contenido</h2>
        <p class="section-intro reveal">
          Comparto lo que aprendo sobre desarrollo de software, DevOps y tecnología:
        </p>
        <div class="cards contenido-cards">
          {
            contenido.map((c, i) => (
              <a
                class="card card-contenido reveal"
                href={c.url}
                target="_blank"
                rel="noopener"
                style={`--delay: ${i * 90}ms; --glow: ${c.brillo}`}
              >
                <span class="contenido-icono">
                  <img src={`${base}icons/${c.icono}.svg`} alt="" width="26" height="26" loading="lazy" />
                </span>
                <h3>{c.nombre}</h3>
                <p>{c.desc}</p>
                <span class="card-accion">{c.accion} →</span>
              </a>
            ))
          }
        </div>
      </section>

      <section id="sobre-mi" class="section">
        <h2 class="reveal"><span class="section-num">04</span> Sobre mí</h2>
        <div class="sobre-grid">
          <div class="reveal">
            <p>
              Trabajo en productos digitales de principio a fin: infraestructura,
              backend, web y móvil. Me gusta automatizar todo lo que se pueda
              automatizar y aprender en público.
            </p>
            <p>
              Publico videos en YouTube y artículos técnicos en Medium sobre
              desarrollo de software, DevOps y tecnología.
            </p>
          </div>
          <div class="reveal" style="--delay: 120ms">
            <h3>Tecnologías</h3>
            <ul class="chips">
              {habilidades.map((h) => <li>{h}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <section id="contacto" class="section contacto">
        <h2 class="reveal"><span class="section-num">05</span> Contacto</h2>
        <p class="reveal">
          ¿Tienes un proyecto en mente o quieres colaborar? Me encantaría escucharte.
        </p>
        <div class="hero-cta reveal" style="--delay: 100ms">
          <a class="btn btn-primary btn-icon" href={`mailto:${perfil.correo}`}>
            <img src={`${base}icons/generic-email.svg`} alt="" width="18" height="18" />
            Escríbeme
          </a>
          {
            redes.slice(0, 2).map((r) => (
              <a class="btn btn-ghost btn-icon" href={r.url} target="_blank" rel="noopener">
                <img src={`${base}icons/${r.icono}.svg`} alt="" width="18" height="18" />
                {r.nombre}
              </a>
            ))
          }
        </div>
        <div class="apoyo reveal" style="--delay: 200ms">
          <p>Si mi trabajo te ha sido útil, puedes apoyarme:</p>
          <div class="hero-cta">
            {
              apoyo.map((a) => (
                <a class="btn btn-ghost btn-icon" href={a.url} target="_blank" rel="noopener">
                  <img src={`${base}icons/${a.icono}.svg`} alt="" width="18" height="18" />
                  {a.nombre}
                </a>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <footer>
      <ul class="redes redes-footer" aria-label="Redes sociales">
        {
          redes.map((r) => (
            <li>
              <a href={r.url} target="_blank" rel="noopener" title={r.nombre} aria-label={r.nombre}>
                <img src={`${base}icons/${r.icono}.svg`} alt="" width="18" height="18" loading="lazy" />
              </a>
            </li>
          ))
        }
      </ul>
      <p>© {new Date().getFullYear()} {perfil.nombre} · Hecho con Astro desde {perfil.ubicacion}</p>
    </footer>

    <script>
      // Animación de aparición al hacer scroll
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>

    <style is:global>
      :root {
        --bg: #0b0d14;
        --surface: rgba(255, 255, 255, 0.04);
        --border: rgba(255, 255, 255, 0.1);
        --text: #e7e9f0;
        --text-dim: #9aa1b5;
        --accent-1: #7c3aed;
        --accent-2: #06b6d4;
        --radius: 16px;
        --sombra-suave: 0 1px 2px rgba(0, 0, 0, 0.35), 0 10px 28px rgba(0, 0, 0, 0.35);
        --sombra-alta: 0 2px 6px rgba(0, 0, 0, 0.45), 0 18px 50px rgba(0, 0, 0, 0.5);
      }

      * {
        box-sizing: border-box;
        margin: 0;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto,
          'Helvetica Neue', Arial, sans-serif;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      /* Fondo aurora con deriva de color lenta */
      .aurora {
        position: fixed;
        inset: 0;
        z-index: -1;
        background:
          radial-gradient(600px 400px at 15% 10%, rgba(124, 58, 237, 0.22), transparent 70%),
          radial-gradient(700px 500px at 85% 20%, rgba(6, 182, 212, 0.16), transparent 70%),
          radial-gradient(800px 600px at 50% 100%, rgba(124, 58, 237, 0.1), transparent 70%);
        animation: aurora-deriva 24s ease-in-out infinite alternate;
      }

      @keyframes aurora-deriva {
        from {
          filter: hue-rotate(0deg);
        }
        to {
          filter: hue-rotate(35deg);
        }
      }

      /* Navegación */
      .nav {
        position: sticky;
        top: 0;
        z-index: 10;
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        background: rgba(11, 13, 20, 0.65);
        border-bottom: 1px solid var(--border);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
      }

      .nav nav {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0.9rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .logo {
        font-weight: 800;
        font-size: 1.25rem;
        letter-spacing: -0.02em;
        color: var(--text);
        text-decoration: none;
      }

      .logo .dot {
        color: var(--accent-2);
      }

      .nav ul {
        display: flex;
        gap: 1.75rem;
        list-style: none;
        padding: 0;
      }

      .nav ul a {
        color: var(--text-dim);
        text-decoration: none;
        font-size: 0.95rem;
        white-space: nowrap;
        transition: color 0.2s;
      }

      .nav ul a:hover {
        color: var(--text);
      }

      main {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      /* Hero */
      .hero {
        min-height: calc(100svh - 65px);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 3rem;
        padding: 4rem 0;
      }

      .hero-texto {
        flex: 1;
        min-width: 0;
      }

      .hero-foto {
        flex-shrink: 0;
        animation: flotar 6s ease-in-out infinite;
      }

      @keyframes flotar {
        0%,
        100% {
          transform: translateY(0);
        }
        50% {
          transform: translateY(-14px);
        }
      }

      .hero-foto img {
        width: clamp(200px, 26vw, 320px);
        height: clamp(200px, 26vw, 320px);
        object-fit: cover;
        border-radius: 50%;
        border: 4px solid transparent;
        background:
          linear-gradient(var(--bg), var(--bg)) padding-box,
          linear-gradient(135deg, var(--accent-1), var(--accent-2)) border-box;
        box-shadow:
          0 0 0 1px rgba(255, 255, 255, 0.06),
          0 24px 70px rgba(124, 58, 237, 0.45),
          0 8px 24px rgba(0, 0, 0, 0.5);
      }

      .hero-kicker {
        color: var(--accent-2);
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-size: 0.85rem;
      }

      .hero h1 {
        font-size: clamp(2.5rem, 7vw, 4.75rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.05;
        margin: 0.5rem 0;
        text-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
      }

      .hero-rol {
        font-size: clamp(1.3rem, 3.5vw, 2rem);
        font-weight: 700;
        letter-spacing: -0.02em;
      }

      /* Degradado animado que recorre el texto */
      .gradient-text {
        background: linear-gradient(90deg, var(--accent-1), var(--accent-2), var(--accent-1));
        background-size: 200% auto;
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        animation: brillo-texto 6s linear infinite;
      }

      @keyframes brillo-texto {
        to {
          background-position: 200% center;
        }
      }

      .hero-desc {
        max-width: 42rem;
        color: var(--text-dim);
        font-size: 1.1rem;
        margin-top: 1.25rem;
      }

      .hero-cta {
        display: flex;
        gap: 1rem;
        margin-top: 2.25rem;
        flex-wrap: wrap;
      }

      /* Redes sociales */
      .redes {
        display: flex;
        gap: 0.75rem;
        list-style: none;
        padding: 0;
        margin-top: 2rem;
        flex-wrap: wrap;
      }

      .redes a {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border-radius: 12px;
        border: 1px solid var(--border);
        background: var(--surface);
        box-shadow: var(--sombra-suave);
        transition: transform 0.2s, border-color 0.2s, background 0.2s, box-shadow 0.2s;
      }

      .redes a:hover {
        transform: translateY(-4px) scale(1.05);
        border-color: rgba(6, 182, 212, 0.6);
        background: rgba(255, 255, 255, 0.08);
        box-shadow: 0 12px 30px rgba(6, 182, 212, 0.25), 0 4px 12px rgba(0, 0, 0, 0.4);
      }

      .redes img {
        display: block;
      }

      .redes-footer {
        justify-content: center;
        margin: 0 0 1.25rem;
      }

      .redes-footer a {
        width: 38px;
        height: 38px;
      }

      /* Botones con brillo al pasar el cursor */
      .btn {
        position: relative;
        overflow: hidden;
        display: inline-block;
        padding: 0.8rem 1.6rem;
        border-radius: 999px;
        font-weight: 600;
        text-decoration: none;
        transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
      }

      .btn::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(
          115deg,
          transparent 30%,
          rgba(255, 255, 255, 0.35) 50%,
          transparent 70%
        );
        transform: translateX(-110%);
        transition: transform 0.55s ease;
        pointer-events: none;
      }

      .btn:hover::before {
        transform: translateX(110%);
      }

      .btn-icon {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
      }

      .btn-primary {
        color: #fff;
        background: linear-gradient(90deg, var(--accent-1), var(--accent-2));
        box-shadow: 0 8px 30px rgba(124, 58, 237, 0.4), 0 2px 8px rgba(0, 0, 0, 0.4);
      }

      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 14px 45px rgba(124, 58, 237, 0.55), 0 4px 12px rgba(0, 0, 0, 0.45);
      }

      .btn-ghost {
        color: var(--text);
        border: 1px solid var(--border);
        background: var(--surface);
        box-shadow: var(--sombra-suave);
      }

      .btn-ghost:hover {
        background: rgba(255, 255, 255, 0.08);
        transform: translateY(-2px);
        box-shadow: var(--sombra-alta);
      }

      /* Secciones */
      .section {
        padding: 5.5rem 0;
        border-top: 1px solid var(--border);
      }

      .section h2 {
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-bottom: 1rem;
      }

      .section-num {
        color: var(--accent-2);
        font-size: 0.9em;
        margin-right: 0.5rem;
        font-variant-numeric: tabular-nums;
      }

      .section-intro {
        color: var(--text-dim);
        max-width: 40rem;
        margin-bottom: 2.5rem;
      }

      .section h2 + .sobre-grid,
      .section h2 + .cards {
        margin-top: 2.5rem;
      }

      /* Lista de áreas (Qué hago): filas grandes tipo editorial */
      .areas {
        list-style: none;
        padding: 0;
        margin: 0;
        border-top: 1px solid var(--border);
      }

      .area {
        position: relative;
        display: grid;
        grid-template-columns: 3.5rem 1.1fr 1.4fr 3.5rem;
        align-items: center;
        gap: 1.5rem;
        padding: 1.9rem 1rem;
        border-bottom: 1px solid var(--border);
        transition: background 0.3s, padding 0.3s;
      }

      /* Resplandor lateral que se enciende al pasar el cursor */
      .area::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 3px;
        background: linear-gradient(180deg, var(--accent-1), var(--accent-2));
        opacity: 0;
        transition: opacity 0.3s;
      }

      .area:hover {
        background: linear-gradient(
          90deg,
          rgba(124, 58, 237, 0.1),
          rgba(6, 182, 212, 0.04) 60%,
          transparent
        );
        padding-left: 1.6rem;
      }

      .area:hover::before {
        opacity: 1;
      }

      .area-num {
        color: var(--accent-2);
        font-weight: 700;
        font-size: 0.9rem;
        font-variant-numeric: tabular-nums;
        opacity: 0.8;
      }

      .area-titulo {
        font-size: clamp(1.15rem, 2.4vw, 1.55rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.2;
        transition: color 0.3s;
      }

      .area:hover .area-titulo {
        background: linear-gradient(90deg, var(--accent-1), var(--accent-2));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .area-desc {
        color: var(--text-dim);
        font-size: 0.98rem;
        margin: 0;
      }

      .area-icono {
        font-size: 1.7rem;
        justify-self: end;
        filter: grayscale(1) opacity(0.45);
        transform: scale(0.9);
        transition: filter 0.3s, transform 0.3s;
      }

      .area:hover .area-icono {
        filter: none;
        transform: scale(1.15) rotate(-6deg);
      }

      .sobre-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 3rem;
        color: var(--text-dim);
      }

      .sobre-grid p + p {
        margin-top: 1rem;
      }

      .sobre-grid h3 {
        color: var(--text);
        margin-bottom: 1rem;
      }

      .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        list-style: none;
        padding: 0;
      }

      .chips li {
        padding: 0.35rem 0.9rem;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: var(--surface);
        font-size: 0.85rem;
        color: var(--text);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
        transition: transform 0.2s, border-color 0.2s;
      }

      .chips li:hover {
        transform: translateY(-2px);
        border-color: rgba(6, 182, 212, 0.5);
      }

      /* Tarjetas de proyectos y contenido */
      .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
      }

      .card {
        display: block;
        padding: 1.75rem;
        border-radius: var(--radius);
        border: 1px solid var(--border);
        background: var(--surface);
        text-decoration: none;
        color: inherit;
        box-shadow: var(--sombra-suave);
        transition: transform 0.25s, border-color 0.25s, background 0.25s, box-shadow 0.25s;
      }

      .card:hover {
        transform: translateY(-6px);
        border-color: rgba(124, 58, 237, 0.5);
        background: rgba(255, 255, 255, 0.06);
        box-shadow: 0 18px 50px var(--glow, rgba(124, 58, 237, 0.28)), 0 4px 14px rgba(0, 0, 0, 0.5);
      }

      .card h3 {
        font-size: 1.2rem;
        margin-bottom: 0.6rem;
      }

      .card p {
        color: var(--text-dim);
        font-size: 0.95rem;
        margin-bottom: 1.1rem;
      }

      .contenido-icono {
        display: grid;
        place-items: center;
        width: 54px;
        height: 54px;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid var(--border);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 8px 24px rgba(0, 0, 0, 0.35);
        margin-bottom: 1.1rem;
        transition: transform 0.25s;
      }

      .card-contenido:hover .contenido-icono {
        transform: scale(1.12) rotate(4deg);
      }

      .card-accion {
        color: var(--accent-2);
        font-weight: 600;
        font-size: 0.95rem;
        display: inline-block;
        transition: transform 0.2s;
      }

      .card-contenido:hover .card-accion {
        transform: translateX(4px);
      }

      .contacto p {
        color: var(--text-dim);
        max-width: 36rem;
      }

      .apoyo {
        margin-top: 3rem;
      }

      .apoyo p {
        font-size: 0.95rem;
        margin-bottom: 0.25rem;
      }

      footer {
        border-top: 1px solid var(--border);
        padding: 2.5rem 1.5rem;
        text-align: center;
        color: var(--text-dim);
        font-size: 0.85rem;
      }

      /* Animaciones de aparición escalonadas */
      .reveal {
        opacity: 0;
        transform: translateY(22px);
        transition: opacity 0.6s ease var(--delay, 0s), transform 0.6s ease var(--delay, 0s);
      }

      .reveal.visible {
        opacity: 1;
        transform: none;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        .reveal {
          opacity: 1;
          transform: none;
          transition: none;
        }
        .aurora,
        .hero-foto,
        .gradient-text {
          animation: none;
        }
        .btn::before {
          display: none;
        }
      }

      @media (max-width: 720px) {
        .hero {
          flex-direction: column-reverse;
          justify-content: center;
          text-align: center;
          gap: 2rem;
        }
        .hero-cta,
        .redes {
          justify-content: center;
        }
        .sobre-grid {
          grid-template-columns: 1fr;
          gap: 2rem;
        }
        .area {
          grid-template-columns: 2.5rem 1fr 2.5rem;
          grid-template-areas:
            'num titulo icono'
            'num desc desc';
          row-gap: 0.4rem;
          column-gap: 0.75rem;
          align-items: start;
          text-align: left;
          padding: 1.4rem 0.5rem;
        }
        .area:hover {
          padding-left: 0.5rem;
        }
        .area-num {
          grid-area: num;
          padding-top: 0.2rem;
        }
        .area-titulo {
          grid-area: titulo;
        }
        .area-desc {
          grid-area: desc;
        }
        .area-icono {
          grid-area: icono;
          padding-top: 0.1rem;
        }
        .nav nav {
          padding: 0.75rem 1rem;
        }
        .nav ul {
          gap: 0.8rem;
        }
        .nav ul a {
          font-size: 0.82rem;
        }
      }
    </style>
  </body>
</html>
