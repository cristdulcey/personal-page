---
// Spanish project case studies, served at /projects/<slug>/.
import { getCollection } from 'astro:content';
import ProjectPost from '../../layouts/ProjectPost.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ id, data }) => id.startsWith('es/') && !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id.split('/').slice(1).join('/') },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<ProjectPost lang="es" project={project} />
