---
// Preview: Dirección Hyper-Editorial Suiza
import Base from '../layouts/Base.astro';
import { profile, translations } from '../i18n';

const t = translations.es;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Base
  lang="es"
  title={`Cristian Dulcey — Hyper-Editorial Suiza`}
  description="Preview de la dirección de diseño Hyper-Editorial Suiza para el portafolio de Cristian Dulcey."
  paths={{ es: 'preview-suizo/', en: 'preview-suizo/' }}
  hreflangAlternates={false}
>
  <!-- Top Switcher Banner -->
  <div class="style-switcher">
    <div class="switcher-content">
      <span class="switcher-badge">PREVIEW B: HIPER-EDITORIAL SUIZA</span>
      <a href={`${base}`} class="switcher-link">← Alternar a versión Telemetry (Linear)</a>
    </div>
  </div>

  <div class="swiss-container">
    <!-- Editorial Masthead / Header Bar -->
    <header class="swiss-masthead">
      <div class="masthead-col col-main">
        <h1 class="swiss-title">CRISTIAN DULCEY</h1>
        <p class="swiss-role">ARQUITECTURA DE SISTEMAS & ESCALA CLOUD</p>
        <span class="coord-tag">REGISTRO CD-2026 · COORDENADAS 4.7110° N, 74.0721° W</span>
      </div>
      <div class="masthead-col col-meta">
        <div class="meta-block">
          <span class="block-label">01 / ENFOQUE</span>
          <p class="block-val">Sistemas distribuidos de alta concurrencia, infraestructura como código y plataformas de escala soberana.</p>
        </div>
        <div class="meta-block">
          <span class="block-label">02 / CREDENCIALES</span>
          <p class="block-val">Core Bancario & Soporte Chivo Wallet (Bitcoin El Salvador) · 300+ Microservicios Fénix (Azure / Bogotá).</p>
        </div>
        <div class="meta-block">
          <span class="block-label">03 / CONTACTO DIRECTO</span>
          <a href={`mailto:${profile.email}`} class="mono-link">{profile.email} ↗</a>
        </div>
      </div>
    </header>

    <!-- Monumental Statement Section -->
    <section class="swiss-statement">
      <div class="statement-grid">
        <div class="stat-number" aria-hidden="true">99%</div>
        <div class="stat-body">
          <h2>INGENIERÍA PARA ESCALA CRÍTICA</h2>
          <p>
            Diseño, despliegue y operación de sistemas donde la tolerancia a fallos no es una métrica secundaria:
            desde la primera adopción nacional de Bitcoin en el mundo hasta la plataforma central de movilidad urbana para una metrópoli de 8 millones de ciudadanos.
          </p>
        </div>
      </div>
    </section>

    <!-- Architectural Schematics Section -->
    <section class="swiss-section">
      <div class="section-banner">
        <span class="sec-index">01</span>
        <span class="sec-title">TOPOLOGÍAS & CASOS DE ESTUDIO INSIGNIA</span>
      </div>

      <div class="schematics-grid">
        <!-- Chivo Wallet Schematic Card -->
        <article class="schematic-entry">
          <div class="entry-header">
            <span class="entry-code">SYS-01 // NACIONAL</span>
            <h3>CHIVO WALLET</h3>
            <span class="entry-sub">GOBIERNO DE EL SALVADOR · BITCOIN LEGAL TENDER</span>
          </div>

          <!-- SVG Architectural Diagram -->
          <div class="blueprint-canvas">
            <svg viewBox="0 0 600 240" fill="none" xmlns="http://www.w3.org/2000/svg" class="blueprint-svg" aria-label="Diagrama arquitectónico de Chivo Wallet">
              <!-- Grid background -->
              <defs>
                <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
                  <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>
                </pattern>
              </defs>
              <rect width="600" height="240" fill="url(#grid)" />
              
              <!-- Block 1: Front Support -->
              <rect x="30" y="40" width="150" height="70" rx="2" stroke="rgba(255,255,255,0.3)" stroke-width="1" fill="#10121a"/>
              <text x="45" y="65" fill="#ffffff" font-family="monospace" font-size="11" font-weight="700">MESA DE AYUDA</text>
              <text x="45" y="85" fill="#9499ad" font-family="monospace" font-size="10">COLA DE INCIDENCIAS</text>
              <text x="45" y="98" fill="#60a5fa" font-family="monospace" font-size="9">ESCALA NACIONAL</text>

              <!-- Connector 1 to 2 -->
              <path d="M 180 75 L 240 75" stroke="#60a5fa" stroke-width="1.5" stroke-dasharray="3 3"/>
              <polygon points="240,75 234,71 234,79" fill="#60a5fa" />

              <!-- Block 2: Decoupling Queue -->
              <rect x="240" y="40" width="140" height="70" rx="2" stroke="rgba(255,255,255,0.3)" stroke-width="1" fill="#10121a"/>
              <text x="255" y="65" fill="#ffffff" font-family="monospace" font-size="11" font-weight="700">DESACOPLAMIENTO</text>
              <text x="255" y="85" fill="#9499ad" font-family="monospace" font-size="10">COLAS ASÍNCRONAS</text>
              <text x="255" y="98" fill="#10b981" font-family="monospace" font-size="9">IDEMPOTENCIA STACK</text>

              <!-- Connector 2 to 3 -->
              <path d="M 380 75 L 440 75" stroke="#60a5fa" stroke-width="1.5" stroke-dasharray="3 3"/>
              <polygon points="440,75 434,71 434,79" fill="#60a5fa" />

              <!-- Block 3: Core Banking -->
              <rect x="440" y="30" width="130" height="90" rx="2" stroke="#2563eb" stroke-width="1.5" fill="#101426"/>
              <text x="455" y="55" fill="#ffffff" font-family="monospace" font-size="11" font-weight="700">CORE BANCARIO</text>
              <text x="455" y="75" fill="#9499ad" font-family="monospace" font-size="10">LEDGER & BALANCES</text>
              <text x="455" y="92" fill="#60a5fa" font-family="monospace" font-size="9">BTC LIGHTNING RAILS</text>
              <text x="455" y="107" fill="#34d399" font-family="monospace" font-size="9">CONCILIACIÓN FIAT</text>

              <!-- Annotations below -->
              <line x1="30" y1="150" x2="570" y2="150" stroke="rgba(255,255,255,0.1)" stroke-width="1" />
              <text x="30" y="175" fill="#9499ad" font-family="monospace" font-size="10">ROL: ARQUITECTURA DE MESA DE AYUDA + MODIFICACIÓN DE COMPONENTES DEL CORE BANCARIO</text>
              <text x="30" y="195" fill="#9499ad" font-family="monospace" font-size="10">ESTADO: PRODUCCIÓN MASIVA (4M+ USUARIOS REGISTRADOS EN ADOPCIÓN HISTÓRICA)</text>
              <text x="30" y="215" fill="#60a5fa" font-family="monospace" font-size="10">LLAVE: TRANSACCIONES CON RESOLUCIÓN ATÓMICA DE CONFLICTOS</text>
            </svg>
          </div>

          <div class="entry-footer">
            <div class="spec-row">
              <span class="spec-lbl">MÉTRICAS:</span>
              <span class="spec-txt">Adopción masiva a escala país · Mesa de soporte de misión crítica</span>
            </div>
            <a href={`${base}projects/chivo/`} class="swiss-btn">Leer caso de estudio completo ↗</a>
          </div>
        </article>

        <!-- Proyecto Fénix Schematic Card -->
        <article class="schematic-entry">
          <div class="entry-header">
            <span class="entry-code">SYS-02 // MUNICIPAL</span>
            <h3>PROYECTO FÉNIX</h3>
            <span class="entry-sub">SECRETARÍA DE MOVILIDAD DE BOGOTÁ · DISTRITO CAPITAL</span>
          </div>

          <!-- SVG Architectural Diagram -->
          <div class="blueprint-canvas">
            <svg viewBox="0 0 600 240" fill="none" xmlns="http://www.w3.org/2000/svg" class="blueprint-svg" aria-label="Diagrama arquitectónico de Proyecto Fénix">
              <rect width="600" height="240" fill="url(#grid)" />
              
              <!-- Block 1: IaC -->
              <rect x="30" y="40" width="140" height="70" rx="2" stroke="rgba(255,255,255,0.3)" stroke-width="1" fill="#10121a"/>
              <text x="45" y="65" fill="#ffffff" font-family="monospace" font-size="11" font-weight="700">TERRAFORM IaC</text>
              <text x="45" y="85" fill="#9499ad" font-family="monospace" font-size="10">100% REPRODUCIBLE</text>
              <text x="45" y="98" fill="#60a5fa" font-family="monospace" font-size="9">MÓDULOS MULTI-ENTORNO</text>

              <!-- Connector 1 to 2 -->
              <path d="M 170 75 L 230 75" stroke="#60a5fa" stroke-width="1.5" stroke-dasharray="3 3"/>
              <polygon points="230,75 224,71 224,79" fill="#60a5fa" />

              <!-- Block 2: Azure DevOps CI/CD -->
              <rect x="230" y="40" width="140" height="70" rx="2" stroke="rgba(255,255,255,0.3)" stroke-width="1" fill="#10121a"/>
              <text x="245" y="65" fill="#ffffff" font-family="monospace" font-size="11" font-weight="700">AZURE DEVOPS</text>
              <text x="245" y="85" fill="#9499ad" font-family="monospace" font-size="10">PIPELINES YAML</text>
              <text x="245" y="98" fill="#10b981" font-family="monospace" font-size="9">ZERO DOWNTIME RELEASE</text>

              <!-- Connector 2 to 3 -->
              <path d="M 370 75 L 430 75" stroke="#60a5fa" stroke-width="1.5" stroke-dasharray="3 3"/>
              <polygon points="430,75 424,71 424,79" fill="#60a5fa" />

              <!-- Block 3: Cluster -->
              <rect x="430" y="30" width="140" height="90" rx="2" stroke="#2563eb" stroke-width="1.5" fill="#101426"/>
              <text x="445" y="55" fill="#ffffff" font-family="monospace" font-size="11" font-weight="700">300+ MICROSERVICIOS</text>
              <text x="445" y="75" fill="#9499ad" font-family="monospace" font-size="10">MICROSOFT AZURE</text>
              <text x="445" y="92" fill="#60a5fa" font-family="monospace" font-size="9">APP SERVICES & AKS</text>
              <text x="445" y="107" fill="#34d399" font-family="monospace" font-size="9">OBSERVABILIDAD 24/7</text>

              <!-- Annotations below -->
              <line x1="30" y1="150" x2="570" y2="150" stroke="rgba(255,255,255,0.1)" stroke-width="1" />
              <text x="30" y="175" fill="#9499ad" font-family="monospace" font-size="10">ROL: RESPONSABLE DE DESPLIEGUE, IaC Y TELEMETRÍA DE 300+ MICROSERVICIOS</text>
              <text x="30" y="195" fill="#9499ad" font-family="monospace" font-size="10">ALCANCE: SISTEMA CENTRAL DE TRÁMITES Y MOVILIDAD DEL DISTRITO CAPITAL (BOGOTÁ)</text>
              <text x="30" y="215" fill="#60a5fa" font-family="monospace" font-size="10">RESULTADO: AUDITORÍA TOTAL DE INFRAESTRUCTURA EN GIT Y ELIMINACIÓN DE DERIVA</text>
            </svg>
          </div>

          <div class="entry-footer">
            <div class="spec-row">
              <span class="spec-lbl">MÉTRICAS:</span>
              <span class="spec-txt">300+ microservicios activos · 100% infraestructura declarativa</span>
            </div>
            <a href={`${base}projects/fenix/`} class="swiss-btn">Leer caso de estudio completo ↗</a>
          </div>
        </article>
      </div>
    </section>

    <!-- Structural Practice Matrix -->
    <section class="swiss-section">
      <div class="section-banner">
        <span class="sec-index">02</span>
        <span class="sec-title">MATRIZ DE ESPECIALIDAD TÉCNICA</span>
      </div>

      <div class="matrix-table">
        <div class="matrix-row">
          <span class="matrix-num" aria-hidden="true">01</span>
          <div class="matrix-name">
            <strong>Arquitectura Cloud & DevOps</strong>
            <span class="matrix-tech">Terraform · Azure · AWS · Kubernetes</span>
          </div>
          <div class="matrix-desc">
            Infraestructura declarativa, trazabilidad en GitOps y observabilidad preventiva para sistemas distribuidos de misión crítica.
          </div>
        </div>

        <div class="matrix-row">
          <span class="matrix-num" aria-hidden="true">02</span>
          <div class="matrix-name">
            <strong>Backends & Sistemas Distribuidos</strong>
            <span class="matrix-tech">Python · Microservicios · PostgreSQL · Colas</span>
          </div>
          <div class="matrix-desc">
            Ingeniería de APIs concurrentes, aislamiento de componentes transaccionales de core bancario y pipelines de procesamiento asíncrono.
          </div>
        </div>

        <div class="matrix-row">
          <span class="matrix-num" aria-hidden="true">03</span>
          <div class="matrix-name">
            <strong>Arquitectura Web Accesible</strong>
            <span class="matrix-tech">Astro · React · TypeScript · Core Web Vitals</span>
          </div>
          <div class="matrix-desc">
            Interfaces hiper-optimizadas con cero sobrecarga de JavaScript innecesario, estándares WCAG AAA/AA y rendimiento impecable.
          </div>
        </div>

        <div class="matrix-row">
          <span class="matrix-num" aria-hidden="true">04</span>
          <div class="matrix-name">
            <strong>Protocolos & Web3</strong>
            <span class="matrix-tech">Open Payments · EVM · Smart Contracts</span>
          </div>
          <div class="matrix-desc">
            Interoperabilidad financiera basada en protocolos abiertos (Rafiki / Interledger) y arquitectura de contratos inteligentes verificados.
          </div>
        </div>
      </div>
    </section>

    <!-- Swiss Executive Footer -->
    <footer class="swiss-footer">
      <div class="footer-meta">
        <span>© {new Date().getFullYear()} CRISTIAN DULCEY</span>
        <span>SISTEMAS DISTRIBUIDOS // BOGOTÁ, COLOMBIA</span>
      </div>
      <div class="footer-actions">
        <a href={`mailto:${profile.email}`} class="swiss-btn-outline">Iniciar consulta técnica ↗</a>
      </div>
    </footer>
  </div>
</Base>

<style>
  /* Style Switcher Banner */
  .style-switcher {
    background: #11141e;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.6rem 1.5rem;
    position: sticky;
    top: 58px;
    z-index: 9;
  }

  .switcher-content {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.8rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .switcher-badge {
    color: #60a5fa;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .switcher-link {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 4px;
    font-weight: 600;
    transition: color 0.2s;
  }

  .switcher-link:hover {
    color: #60a5fa;
  }

  /* Swiss Layout Canvas */
  .swiss-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 6rem;
    font-family: 'Public Sans', system-ui, sans-serif;
  }

  /* Editorial Masthead */
  .swiss-masthead {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    padding-bottom: 3.5rem;
    margin-bottom: 3.5rem;
  }

  .coord-tag {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.78rem;
    font-weight: 700;
    color: #60a5fa;
    letter-spacing: 0.06em;
    display: block;
    margin-bottom: 1rem;
  }

  .swiss-title {
    font-size: clamp(2.8rem, 6.5vw, 5.25rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 0.95;
    margin: 0 0 1rem;
    color: #ffffff;
  }

  .swiss-role {
    font-size: clamp(1rem, 2vw, 1.35rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    color: #9499ad;
    margin: 0;
  }

  .masthead-col.col-meta {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    padding-left: 2rem;
    border-left: 1px solid rgba(255, 255, 255, 0.12);
  }

  .meta-block {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .block-label {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.75rem;
    font-weight: 700;
    color: #60a5fa;
    letter-spacing: 0.05em;
  }

  .block-val {
    font-size: 0.92rem;
    line-height: 1.55;
    color: #d1d5e4;
    margin: 0;
  }

  .mono-link {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.88rem;
    color: #ffffff;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
    width: fit-content;
  }

  /* Monumental Statement */
  .swiss-statement {
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    padding-bottom: 3.5rem;
    margin-bottom: 3.5rem;
  }

  .statement-grid {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 3rem;
    align-items: baseline;
  }

  .stat-number {
    font-size: clamp(4rem, 10vw, 7.5rem);
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 0.85;
    color: #8b92a8;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
  }

  .stat-body h2 {
    font-size: clamp(1.4rem, 3vw, 2.1rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0 0 1rem;
  }

  .stat-body p {
    font-size: 1.15rem;
    line-height: 1.65;
    color: #9499ad;
    max-width: 48rem;
    margin: 0;
  }

  /* Section Framing */
  .swiss-section {
    margin-bottom: 4.5rem;
  }

  .section-banner {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid #ffffff;
    margin-bottom: 2rem;
  }

  .sec-index {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 1.4rem;
    font-weight: 800;
    color: #60a5fa;
  }

  .sec-title {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #ffffff;
  }

  /* Schematics Layout */
  .schematics-grid {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .schematic-entry {
    background: #0d0f17;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 4px;
    padding: 1.75rem;
  }

  .entry-header {
    margin-bottom: 1.5rem;
  }

  .entry-code {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.75rem;
    font-weight: 700;
    color: #60a5fa;
    display: block;
    margin-bottom: 0.4rem;
  }

  .entry-header h3 {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0 0 0.4rem;
  }

  .entry-sub {
    font-size: 0.85rem;
    color: #9499ad;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
  }

  .blueprint-canvas {
    background: #07080d;
    border: 1px solid rgba(255, 255, 255, 0.08);
    margin: 1.25rem 0 1.5rem;
    padding: 1.25rem;
    overflow-x: auto;
  }

  .blueprint-svg {
    width: 100%;
    min-width: 520px;
    height: auto;
    display: block;
  }

  .entry-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 1.25rem;
  }

  .spec-row {
    font-size: 0.88rem;
    color: #d1d5e4;
  }

  .spec-lbl {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.78rem;
    font-weight: 700;
    color: #60a5fa;
    margin-right: 0.5rem;
  }

  .swiss-btn {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.82rem;
    font-weight: 700;
    color: #ffffff;
    background: #2563eb;
    padding: 0.6rem 1.2rem;
    border-radius: 2px;
    text-decoration: none;
    transition: background 0.2s;
  }

  .swiss-btn:hover {
    background: #1d4ed8;
  }

  /* Technical Matrix */
  .matrix-table {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .matrix-row {
    display: grid;
    grid-template-columns: 80px 1.2fr 1.6fr;
    gap: 2rem;
    align-items: baseline;
    padding: 1.75rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .matrix-num {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 1.4rem;
    font-weight: 800;
    color: #8b92a8;
  }

  .matrix-name {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .matrix-name strong {
    font-size: 1.2rem;
    font-weight: 700;
    color: #ffffff;
  }

  .matrix-tech {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.8rem;
    color: #60a5fa;
  }

  .matrix-desc {
    font-size: 0.95rem;
    color: #9499ad;
    line-height: 1.6;
  }

  /* Swiss Executive Footer */
  .swiss-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    padding-top: 2.5rem;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .footer-meta {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.8rem;
    color: #9499ad;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .swiss-btn-outline {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.82rem;
    font-weight: 700;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 0.6rem 1.2rem;
    border-radius: 2px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .swiss-btn-outline:hover {
    background: #ffffff;
    color: #090a0f;
  }

  /* Mobile Optimizations */
  @media (max-width: 820px) {
    .swiss-masthead {
